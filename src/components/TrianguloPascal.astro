---
/**
 * Triângulo de Pascal colorido pelo resto da divisão de cada elemento por um divisor à escolha.
 * Com divisor 2 aparece o triângulo de Sierpiński.
 */
interface Props {
  linhas?: number;
  divisores?: number[];
}

const { linhas = 32, divisores = [2, 3, 4, 5, 7] } = Astro.props;
---

<maismat-pascal class="pascal" data-linhas={linhas}>
  <div class="ui controlos" role="group" aria-label="Divisor">
    <span>Colorir pelo resto da divisão por</span>
    {divisores.map((d, i) => (
      <button type="button" data-d={d} aria-pressed={i === 0 ? 'true' : 'false'}>{d}</button>
    ))}
  </div>
  <svg role="img" aria-label="Triângulo de Pascal colorido pelos restos"></svg>
  <p class="ui legenda"></p>
</maismat-pascal>

<script>
  const CORES = ['#f3ecdc', '#e5481b', '#4f6f8f', '#5b8a35', '#d4a017', '#8e5ba8', '#2a9d8f'];

  class Pascal extends HTMLElement {
    connectedCallback() {
      const n = Number(this.dataset.linhas);
      const svg = this.querySelector('svg')!;
      const legenda = this.querySelector('.legenda')!;
      const botoes = [...this.querySelectorAll<HTMLButtonElement>('button')];
      // Usamos BigInt porque os valores crescem muito depressa
      const tri: bigint[][] = [[1n]];
      for (let l = 1; l < n; l++) {
        const ant = tri[l - 1];
        tri.push(Array.from({ length: l + 1 }, (_, k) => (k === 0 || k === l ? 1n : ant[k - 1] + ant[k])));
      }
      const r = 10;
      const h = r * Math.sqrt(3);
      svg.setAttribute('viewBox', `${-n * r - r} ${-r} ${2 * n * r + 2 * r} ${n * h + r}`);

      const desenhar = (d: number) => {
        const D = BigInt(d);
        svg.innerHTML = tri
          .flatMap((linha, l) =>
            linha.map((v, k) => {
              const resto = Number(v % D);
              const x = (2 * k - l) * r;
              const y = l * h;
              return `<circle cx="${x}" cy="${y}" r="${r * 0.92}" fill="${CORES[resto % CORES.length]}"><title>${v} (resto ${resto})</title></circle>`;
            }),
          )
          .join('');
        legenda.textContent =
          d === 2
            ? 'Pares a bege, ímpares a laranja. Reconheces o triângulo de Sierpiński?'
            : `Cada cor corresponde a um resto: 0, 1, …, ${d - 1}. Passa o rato por cima de um círculo para veres o número.`;
        botoes.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.d) === d)));
      };

      botoes.forEach((b) => b.addEventListener('click', () => desenhar(Number(b.dataset.d))));
      desenhar(Number(botoes[0].dataset.d));
    }
  }

  customElements.define('maismat-pascal', Pascal);
</script>

<style>
  .pascal { display: block; margin: 2rem 0; background: var(--superficie); border: 1px solid var(--linha); border-radius: var(--raio); padding: 1rem; }
  .controlos { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; font-size: 0.9rem; margin-bottom: 0.75rem; }
  .controlos span { margin-right: 0.3rem; }
  button {
    font: inherit; font-weight: 600; min-width: 2.2rem; padding: 0.25rem 0.6rem;
    border: 1px solid var(--linha); border-radius: 6px; background: var(--fundo); color: var(--texto); cursor: pointer;
  }
  button[aria-pressed='true'] { background: var(--azul); border-color: var(--azul); color: #fff; }
  svg { width: 100%; height: auto; display: block; }
  .legenda { font-size: 0.85rem; color: var(--texto-suave); margin: 0.75rem 0 0; }
</style>
