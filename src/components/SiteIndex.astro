---
// Pages that lead to everything without searching: the fallback of /pesquisa/ and of the 404 page.
import { getSortedIssues, monthYear, issueLabel } from '../lib/issues';

const issues = await getSortedIssues();
---

<ul class="ui site-index">
  <li>
    <a href="/desafios/">Arquivo de desafios</a>
  </li>
  <li>
    <a href="/seccoes/">Secções</a>
  </li>
  <li>
    <a href="/edicoes/">Edições</a>
    <ul>
      {issues.map((issue) => (
        <li>
          <a href={`/edicoes/${issue.id}/`}>
            {issueLabel(issue)} · <span class="capitalize">{monthYear(issue.data.date)}</span>
          </a>
        </li>
      ))}
    </ul>
  </li>
</ul>

<style>
  .site-index,
  .site-index ul {
    padding-left: 1.25rem;
  }
  li {
    margin: 0.25rem 0;
  }
</style>
