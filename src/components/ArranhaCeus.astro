---
/**
 * Puzzle "Arranha-céus" jogável.
 * As pistas leem-se de fora para dentro: `cima` da esquerda para a direita,
 * `esquerda` de cima para baixo, etc. 0 = sem pista.
 * `inicial` permite dar casas já preenchidas (linhas separadas por "/", 0 = vazia).
 */
interface Props {
  cima: number[];
  baixo: number[];
  esquerda: number[];
  direita: number[];
  inicial?: string;
  titulo?: string;
}

const { cima, baixo, esquerda, direita, inicial, titulo = 'Joga aqui' } = Astro.props;
const n = cima.length;
const dadas = inicial ? inicial.split('/').map((l) => [...l].map(Number)) : [];
const pista = (v: number) => (v ? String(v) : '');
---

<maismat-arranha-ceus
  class="arranha"
  data-n={n}
  data-pistas={JSON.stringify({ cima, baixo, esquerda, direita })}
>
  <p class="ui titulo">{titulo}</p>
  <div class="tabuleiro" style={`--n:${n}`}>
    <span></span>
    {cima.map((v) => <span class="pista">{pista(v)}</span>)}
    <span></span>
    {Array.from({ length: n }, (_, l) => (
      <>
        <span class="pista">{pista(esquerda[l])}</span>
        {Array.from({ length: n }, (_, c) => {
          const v = dadas[l]?.[c] ?? 0;
          return (
            <button
              type="button"
              class="casa"
              data-l={l}
              data-c={c}
              data-fixa={v ? '' : undefined}
              aria-label={`Linha ${l + 1}, coluna ${c + 1}`}
            >
              {v || ''}
            </button>
          );
        })}
        <span class="pista">{pista(direita[l])}</span>
      </>
    ))}
    <span></span>
    {baixo.map((v) => <span class="pista">{pista(v)}</span>)}
    <span></span>
  </div>
  <p class="ui ajuda">Clica numa casa para mudar a altura (1 → {n} → vazio), ou escreve um número com o teclado.</p>
  <p class="ui estado" role="status" aria-live="polite"></p>
  <button type="button" class="ui limpar">Recomeçar</button>
</maismat-arranha-ceus>

<script>
  type Pistas = { cima: number[]; baixo: number[]; esquerda: number[]; direita: number[] };

  const visiveis = (fila: number[]) => {
    let max = 0;
    let vistos = 0;
    for (const h of fila) if (h > max) { max = h; vistos++; }
    return vistos;
  };

  class ArranhaCeus extends HTMLElement {
    connectedCallback() {
      const n = Number(this.dataset.n);
      const p: Pistas = JSON.parse(this.dataset.pistas!);
      const casas = [...this.querySelectorAll<HTMLButtonElement>('.casa')];
      const estado = this.querySelector<HTMLElement>('.estado')!;
      const valor = (b: HTMLButtonElement) => Number(b.textContent) || 0;
      const grelha = () => Array.from({ length: n }, (_, l) => casas.slice(l * n, l * n + n).map(valor));

      const verificar = () => {
        const g = grelha();
        casas.forEach((b) => b.classList.remove('conflito'));
        // Repetições na mesma linha ou coluna
        for (let i = 0; i < n; i++) {
          for (let j = 0; j < n; j++) {
            const v = g[i][j];
            if (!v) continue;
            for (let k = 0; k < n; k++) {
              if ((k !== j && g[i][k] === v) || (k !== i && g[k][j] === v)) casas[i * n + j].classList.add('conflito');
            }
          }
        }
        const completo = g.every((l) => l.every(Boolean));
        if (!completo) { estado.textContent = ''; this.dataset.resolvido = 'nao'; return; }

        const cols = Array.from({ length: n }, (_, c) => g.map((l) => l[c]));
        const ok =
          !casas.some((b) => b.classList.contains('conflito')) &&
          p.esquerda.every((v, i) => !v || visiveis(g[i]) === v) &&
          p.direita.every((v, i) => !v || visiveis([...g[i]].reverse()) === v) &&
          p.cima.every((v, i) => !v || visiveis(cols[i]) === v) &&
          p.baixo.every((v, i) => !v || visiveis([...cols[i]].reverse()) === v);
        this.dataset.resolvido = ok ? 'sim' : 'nao';
        estado.textContent = ok ? 'Parabéns, resolveste o puzzle! 🎉' : 'A grelha está cheia, mas alguma pista não é cumprida.';
      };

      const definir = (b: HTMLButtonElement, v: number) => {
        if (b.hasAttribute('data-fixa')) return;
        b.textContent = v ? String(v) : '';
        verificar();
      };

      casas.forEach((b) => {
        b.addEventListener('click', () => definir(b, (valor(b) + 1) % (n + 1)));
        b.addEventListener('keydown', (e) => {
          const i = casas.indexOf(b);
          const mover: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -n, ArrowDown: n };
          if (e.key in mover) {
            casas[i + mover[e.key]]?.focus();
            e.preventDefault();
          } else if (/^[0-9]$/.test(e.key) && Number(e.key) <= n) {
            definir(b, Number(e.key));
          } else if (e.key === 'Backspace' || e.key === 'Delete') {
            definir(b, 0);
          }
        });
      });

      this.querySelector('.limpar')!.addEventListener('click', () => {
        casas.forEach((b) => !b.hasAttribute('data-fixa') && (b.textContent = ''));
        verificar();
      });
    }
  }

  customElements.define('maismat-arranha-ceus', ArranhaCeus);
</script>

<style>
  .arranha {
    display: block;
    background: var(--superficie);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
    padding: 0 1.25rem 1.25rem;
    margin: 2rem 0;
    text-align: center;
    overflow: hidden;
  }
  /* A moldura dos jogos é a faixa dourada com o nome */
  .titulo { margin: 0 -1.25rem 1rem; padding: 0.625rem 1rem; background: var(--etiqueta); color: var(--etiqueta-texto); font-size: 0.875rem; font-weight: 700; text-align: left; }
  .tabuleiro {
    display: inline-grid;
    grid-template-columns: repeat(calc(var(--n) + 2), 2.75rem);
    grid-auto-rows: 2.75rem;
    gap: 4px;
  }
  .pista {
    display: grid;
    place-items: center;
    font-family: var(--f-ui);
    font-weight: 700;
    color: var(--rotulo);
  }
  .casa {
    font: 600 1.35rem var(--f-ui);
    color: var(--primaria);
    background: var(--superficie);
    border: 2px solid var(--campo);
    border-radius: var(--raio-p);
    cursor: pointer;
  }
  .casa:focus-visible { outline: 3px solid var(--primaria); outline-offset: 1px; }
  .casa[data-fixa] { color: var(--texto); background: var(--pastilha); border-color: var(--pastilha); cursor: default; }
  .casa.conflito { border-color: var(--erro); color: var(--erro); }
  [data-resolvido='sim'] .casa { border-color: var(--ok); }
  .ajuda { font-size: 0.8125rem; color: var(--texto-suave); margin: 0.75rem 0 0; }
  .estado { min-height: 1.4em; font-weight: 600; margin: 0.5rem 0; }
  [data-resolvido='sim'] .estado { color: var(--ok); }
  .limpar {
    min-height: 44px;
    padding: 0 1rem;
    border: 2px solid var(--primaria);
    border-radius: var(--raio);
    background: var(--superficie);
    color: var(--primaria);
    font: 700 0.875rem var(--f-ui);
    cursor: pointer;
  }
  @media (max-width: 26rem) {
    .tabuleiro { grid-template-columns: repeat(calc(var(--n) + 2), 2.3rem); grid-auto-rows: 2.3rem; }
  }
  @media print { .ajuda, .estado, .limpar { display: none; } }
</style>
