---
/** GeoGebra applet behind a button: the browser only contacts geogebra.org (and its cookies) when the reader asks. */
import { geogebraUrls } from '../../public/admin/components.js';

interface Props {
  url: string;
  title: string;
  height?: number;
}
const { url, title, height = 500 } = Astro.props;
const urls = geogebraUrls(url, height);
if (!urls)
  throw new Error(
    `The link «${url}» of the «Applet GeoGebra» block is not an applet link. In GeoGebra, press «Partilhar» (Share) and copy the link (https://www.geogebra.org/m/…).`,
  );
---

<figure class="applet">
  <maismat-geogebra
    class="no-print"
    data-src={urls.iframe}
    data-title={title}
    style={`aspect-ratio: 800 / ${height}`}
    data-pagefind-ignore
  >
    <div class="facade ui">
      <p>
        <strong>Applet GeoGebra:</strong> {title}
      </p>
      <p class="notice">Ao abrir, o browser liga-se a geogebra.org, que pode guardar cookies.</p>
      <button type="button">Abrir o applet</button>
      <a href={urls.page}>ou abrir no site do GeoGebra</a>
    </div>
  </maismat-geogebra>
  <p class="ui print-only" data-pagefind-ignore>
    Applet GeoGebra «{title}»: {urls.page}
  </p>
</figure>

<script>
  class GeoGebra extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')!.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        Object.assign(iframe, {
          src: this.dataset.src!,
          title: this.dataset.title!,
          allow: 'fullscreen',
          referrerPolicy: 'strict-origin-when-cross-origin',
        });
        // allow-same-origin is safe here: the origin is geogebra.org's, not the site's.
        iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox');
        this.replaceChildren(iframe);
        iframe.focus();
      });
    }
  }
  customElements.define('maismat-geogebra', GeoGebra);
</script>

<style>
  maismat-geogebra {
    display: grid;
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    border: 2px dashed var(--field-border);
    background: var(--surface);
  }
  maismat-geogebra:has(iframe) {
    border-style: solid;
    border-color: var(--border);
  }
  .facade {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.625rem;
    padding: 1.25rem;
    text-align: center;
    font-size: 0.9375rem;
  }
  .facade p {
    margin: 0;
  }
  .notice {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  .facade a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
  }
  button {
    min-height: 44px;
    padding: 0 1.125rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--on-primary);
    font: 700 0.875rem var(--font-ui);
    cursor: pointer;
  }
  button:hover {
    background: var(--primary-strong);
  }
  button:focus-visible {
    outline-color: var(--text);
  }
  maismat-geogebra:not(:defined) button {
    display: none;
  }
  /* The iframe is created by the script, so it lacks this component's scoping attribute. */
  maismat-geogebra :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: calc(var(--radius) - 2px);
  }
</style>
