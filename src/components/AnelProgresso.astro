---
// Anel «N de T» com os desafios resolvidos neste aparelho (as mesmas chaves do Desafio.astro).
// Sem JavaScript mostra 0; volta a contar quando o arquivo junta progresso (evento maismat:progresso).
interface Props {
  ids: string[];
}
const ids = [...new Set(Astro.props.ids)];
---

<maismat-anel class="ui" data-ids={ids.join(' ')}>
  <svg viewBox="0 0 36 36" aria-hidden="true">
    <circle class="trilho" cx="18" cy="18" r="15.5" pathLength="100" />
    <circle class="cheio" cx="18" cy="18" r="15.5" pathLength="100" />
  </svg>
  <span class="texto">
    <strong>
      <span class="n">0</span> de {ids.length}
    </strong>{' '}
    resolvidos
  </span>
</maismat-anel>

<script>
  class Anel extends HTMLElement {
    connectedCallback() {
      this.contar();
      document.addEventListener('maismat:progresso', () => this.contar());
    }
    contar() {
      const ids = this.dataset.ids!.split(' ');
      const n = ids.filter((id) => {
        try {
          return localStorage.getItem(`maismat:${id}`) === 'ok';
        } catch {
          return false;
        }
      }).length;
      this.querySelector('.n')!.textContent = String(n);
      this.style.setProperty('--p', String((100 * n) / ids.length));
    }
  }
  customElements.define('maismat-anel', Anel);
</script>

<style>
  /* Registado como número para o anel se encher a partir de zero; sem @property aparece já cheio */
  @property --p {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  maismat-anel {
    --p: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: --p 400ms ease-out;
  }
  svg {
    width: 5rem;
    height: 5rem;
    transform: rotate(-90deg);
    flex-shrink: 0;
  }
  circle {
    fill: none;
    stroke-width: 4.5;
  }
  .trilho {
    stroke: var(--pastilha);
  }
  .cheio {
    stroke: var(--ok);
    /* O traço tem o comprimento da percentagem: com 0 não se desenha nada (o dashoffset deixava um risco) */
    stroke-dasharray: var(--p) 100;
  }
  .texto {
    display: grid;
    font-size: 0.875rem;
    color: var(--texto-suave);
  }
  strong {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--texto);
  }
</style>
