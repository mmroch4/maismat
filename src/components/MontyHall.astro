---
/** Monty Hall problem game and simulation: three doors, one car and two goats. */
---

<maismat-monty-hall class="monty">
  <p class="ui instructions" aria-live="polite">
    Escolhe uma porta.
  </p>
  <div class="doors">
    {[1, 2, 3].map((number) => (
      <button type="button" class="door" aria-label={`Porta ${number}`}>
        <span class="number">{number}</span>
        <span class="prize" aria-hidden="true"></span>
      </button>
    ))}
  </div>
  <div class="ui actions">
    <button type="button" class="stay" hidden>
      Manter a escolha
    </button>
    <button type="button" class="switch" hidden>
      Mudar de porta
    </button>
    <button type="button" class="play-again" hidden>
      Jogar outra vez
    </button>
  </div>
  <table class="ui scoreboard">
    <thead>
      <tr>
        <th></th>
        <th>Jogos</th>
        <th>Ganhos</th>
        <th>% de vitórias</th>
      </tr>
    </thead>
    <tbody>
      <tr data-strategy="stay">
        <th>A manter</th>
        <td>0</td>
        <td>0</td>
        <td>—</td>
      </tr>
      <tr data-strategy="switch">
        <th>A mudar</th>
        <td>0</td>
        <td>0</td>
        <td>—</td>
      </tr>
    </tbody>
  </table>
  <button type="button" class="ui simulate">
    Simular 1000 jogos de cada estratégia
  </button>
</maismat-monty-hall>

<script>
  type Strategy = 'stay' | 'switch';

  const DOORS = [0, 1, 2];
  const SIMULATED_GAMES = 1000;
  const randomDoor = () => Math.floor(Math.random() * DOORS.length);

  class MontyHall extends HTMLElement {
    carDoor = 0;
    chosenDoor = -1;
    openedDoor = -1;
    // [games, wins] per strategy
    score: Record<Strategy, [number, number]> = { stay: [0, 0], switch: [0, 0] };

    connectedCallback() {
      const doors = [...this.querySelectorAll<HTMLButtonElement>('.door')];
      const instructions = this.querySelector('.instructions')!;
      const [stayButton, switchButton, playAgainButton] = ['.stay', '.switch', '.play-again'].map((selector) =>
        this.querySelector<HTMLButtonElement>(selector)!,
      );

      const prizeBehind = (door: number) => (door === this.carDoor ? '🚗' : '🐐');
      const reset = () => {
        this.carDoor = randomDoor();
        this.chosenDoor = this.openedDoor = -1;
        doors.forEach((door) => {
          door.dataset.state = '';
          door.disabled = false;
          door.querySelector('.prize')!.textContent = '';
        });
        stayButton.hidden = switchButton.hidden = playAgainButton.hidden = true;
        instructions.textContent = 'Escolhe uma porta.';
      };

      const openDoor = (door: number) => {
        doors[door].dataset.state = 'open';
        doors[door].querySelector('.prize')!.textContent = prizeBehind(door);
      };

      doors.forEach((button, door) =>
        button.addEventListener('click', () => {
          if (this.chosenDoor !== -1) return;
          this.chosenDoor = door;
          button.dataset.state = 'chosen';
          const goatDoors = DOORS.filter((other) => other !== door && other !== this.carDoor);
          this.openedDoor = goatDoors[Math.floor(Math.random() * goatDoors.length)];
          openDoor(this.openedDoor);
          doors.forEach((other) => (other.disabled = true));
          instructions.textContent = `O apresentador abriu a porta ${this.openedDoor + 1}: tem uma cabra! Queres mudar de porta?`;
          stayButton.hidden = switchButton.hidden = false;
        }),
      );

      const decide = (strategy: Strategy) => {
        if (strategy === 'switch')
          this.chosenDoor = DOORS.find((door) => door !== this.chosenDoor && door !== this.openedDoor)!;
        DOORS.forEach(openDoor);
        doors[this.chosenDoor].dataset.state = 'final';
        const won = this.chosenDoor === this.carDoor;
        this.record(strategy, won ? 1 : 0, 1);
        instructions.textContent = won ? 'Ganhaste o carro! 🎉' : 'Calhou-te uma cabra…';
        stayButton.hidden = switchButton.hidden = true;
        playAgainButton.hidden = false;
      };
      stayButton.addEventListener('click', () => decide('stay'));
      switchButton.addEventListener('click', () => decide('switch'));
      playAgainButton.addEventListener('click', reset);

      this.querySelector('.simulate')!.addEventListener('click', () => {
        for (const strategy of ['stay', 'switch'] as Strategy[]) {
          let wins = 0;
          for (let game = 0; game < SIMULATED_GAMES; game++) {
            const car = randomDoor();
            const firstChoice = randomDoor();
            // Switching wins exactly when the first choice was wrong
            if ((strategy === 'stay') === (firstChoice === car)) wins++;
          }
          this.record(strategy, wins, SIMULATED_GAMES);
        }
      });

      reset();
    }

    record(strategy: Strategy, wins: number, games: number) {
      const score = this.score[strategy];
      score[0] += games;
      score[1] += wins;
      const cells = this.querySelectorAll(`tr[data-strategy="${strategy}"] td`);
      cells[0].textContent = score[0].toLocaleString('pt-PT');
      cells[1].textContent = score[1].toLocaleString('pt-PT');
      cells[2].textContent = `${((100 * score[1]) / score[0]).toLocaleString('pt-PT', { maximumFractionDigits: 1 })} %`;
    }
  }

  customElements.define('maismat-monty-hall', MontyHall);
</script>

<style>
  .monty {
    display: block;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border-top: 6px solid var(--tag);
    padding: 1.25rem;
    margin: 2rem 0;
    text-align: center;
  }
  .instructions {
    font-weight: 600;
    min-height: 2.8em;
    margin: 0 0 0.75rem;
  }
  .doors {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }
  .door {
    width: 5.5rem;
    height: 8rem;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    border: 3px solid var(--primary-strong);
    background: linear-gradient(#4f7398, #3d5a78);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    font: 700 1.6rem var(--font-ui);
    position: relative;
  }
  .door:disabled {
    cursor: default;
  }
  .door[data-state='chosen'] {
    outline: 4px solid var(--tag);
    outline-offset: 2px;
  }
  .door[data-state='open'],
  .door[data-state='final'] {
    background: var(--surface);
    color: var(--text);
  }
  .door[data-state='final'] {
    outline: 4px solid var(--ok);
    outline-offset: 2px;
  }
  .prize {
    font-size: 2.4rem;
    position: absolute;
    bottom: 0.6rem;
  }
  .door[data-state='open'] .number,
  .door[data-state='final'] .number {
    position: absolute;
    top: 0.3rem;
    font-size: 1rem;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 1rem 0;
    min-height: 2.4rem;
    flex-wrap: wrap;
  }
  .actions button,
  .simulate {
    min-height: 44px;
    padding: 0 1.125rem;
    border-radius: var(--radius);
    border: 2px solid var(--primary);
    background: var(--primary);
    color: var(--on-primary);
    font: 700 0.875rem var(--font-ui);
    cursor: pointer;
  }
  .actions button:focus-visible {
    outline-color: var(--text);
  }
  .simulate {
    background: var(--surface);
    color: var(--primary);
    margin-top: 0.75rem;
  }
  .scoreboard {
    margin: 0 auto;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .scoreboard th,
  .scoreboard td {
    padding: 0.3rem 0.7rem;
    border-bottom: 1px solid var(--border);
  }
  .scoreboard thead th {
    font-weight: 600;
    color: var(--text-muted);
  }
  @media print {
    .monty {
      display: none;
    }
  }
</style>
