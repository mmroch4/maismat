---
/**
 * Desafio com verificação de resposta no browser.
 *
 * Quem escreve o artigo coloca a resposta em texto simples (`resposta="31"`);
 * no build só é publicado o hash SHA-256, por isso a resposta não aparece no HTML.
 * Várias respostas aceites separam-se com "|" (ex.: "31|trinta e um").
 * Com `opcoes`, o desafio passa a escolha múltipla.
 * Com `casas`, a resposta é tratada como número e arredondada a esse número de casas decimais
 * (ex.: `resposta="56.54" casas={1}` aceita 56,5 e 56,54).
 * O `id` é a âncora e a chave do progresso guardado no browser: é gerado pelo painel quando o desafio
 * é criado e não deve mudar depois, nem quando se corrige o título.
 */
import { createHash } from 'node:crypto';
import { normalizar } from '../lib/respostas.mjs';

interface Props {
  id: string;
  titulo: string;
  numero?: number | string;
  resposta?: string;
  opcoes?: string[];
  unidade?: string;
  fonte?: string;
  casas?: number;
}

const { id, titulo, numero, resposta, opcoes, unidade, fonte, casas } = Astro.props;
if (!id) throw new Error(`O desafio “${titulo}” não tem id. Abre-o no painel e guarda, ou escreve id="desafio-…" no artigo.`);

const hashes = resposta
  ? resposta.split('|').map((r) => createHash('sha256').update(id + normalizar(r, casas)).digest('hex'))
  : [];
const temResolucao = Astro.slots.has('resolucao');
---

<maismat-desafio class="desafio" id={id} data-hashes={hashes.join(',')} data-casas={casas}>
  <header>
    <span class="ui rotulo">Desafio{numero !== undefined && ` ${numero}`}</span>
    <h3>{titulo}</h3>
  </header>

  <div class="enunciado"><slot /></div>
  {fonte && <p class="fonte ui">{fonte}</p>}

  {hashes.length > 0 && (
    <form class="ui resposta nao-imprimir" data-pagefind-ignore>
      {opcoes ? (
        <fieldset>
          <legend>Escolhe a tua resposta</legend>
          {opcoes.map((o) => (
            <label class="opcao">
              <input type="radio" name={`${id}-r`} value={o} required />
              <span>{o}</span>
            </label>
          ))}
        </fieldset>
      ) : (
        <label>
          <span>A tua resposta</span>
          <span class="campo">
            <input type="text" name="r" inputmode="text" autocomplete="off" required />
            {unidade && <span class="unidade">{unidade}</span>}
          </span>
        </label>
      )}
      <button type="submit">Verificar</button>
      <p class="feedback" role="status" aria-live="polite"></p>
    </form>
  )}

  {temResolucao ? (
    <details class="resolucao">
      <summary class="ui">{hashes.length ? 'Ver resolução' : 'Resolução'}</summary>
      <div><slot name="resolucao" /></div>
    </details>
  ) : (
    <p class="ui pendente" data-pagefind-ignore>A resolução será publicada na próxima edição. Envia a tua resposta à equipa do +MAT!</p>
  )}
</maismat-desafio>

<script>
  import { normalizar } from '../lib/respostas.mjs';

  async function sha256(texto: string) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(texto));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  const chave = (id: string) => `maismat:${id}`;

  class Desafio extends HTMLElement {
    tentativas = 0;

    connectedCallback() {
      const form = this.querySelector('form');
      if (!form) return;
      const hashes = (this.dataset.hashes ?? '').split(',');
      const casas = this.dataset.casas ? Number(this.dataset.casas) : undefined;
      const feedback = form.querySelector<HTMLElement>('.feedback')!;

      try {
        if (localStorage.getItem(chave(this.id)) === 'ok') this.marcarResolvido(feedback, true);
      } catch {}

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const valor = new FormData(form).values().next().value as string | undefined;
        if (!valor?.trim()) return;
        const certo = hashes.includes(await sha256(this.id + normalizar(valor, casas)));
        this.tentativas++;
        if (certo) {
          this.marcarResolvido(feedback, false);
          try { localStorage.setItem(chave(this.id), 'ok'); } catch {}
        } else {
          this.dataset.estado = 'errado';
          feedback.textContent =
            this.tentativas < 3 ? 'Ainda não. Tenta outra vez!' : 'Ainda não. Se quiseres, espreita a resolução.';
        }
      });
    }

    marcarResolvido(feedback: HTMLElement, anterior: boolean) {
      this.dataset.estado = 'certo';
      feedback.textContent = anterior ? 'Já resolveste este desafio. ✓' : 'Certo! Muito bem. ✓';
      const det = this.querySelector('details');
      if (det && !anterior) det.open = true;
    }
  }

  customElements.define('maismat-desafio', Desafio);
</script>

<style>
  /* Os estados vêm de data-estado (errado, certo), postos pelo script; o resto é CSS. */
  .desafio {
    display: block;
    background: var(--fundo);
    border-radius: var(--raio);
    box-shadow: inset 0 0 0 1px var(--linha);
    padding: 1.25rem;
    margin: 2rem 0;
  }
  [data-estado='errado'] { background: var(--erro-fundo); box-shadow: none; }
  [data-estado='certo'] { background: var(--ok-fundo); box-shadow: none; }

  header { margin-bottom: 0.75rem; }
  .rotulo {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.2rem 0.625rem;
    border-radius: var(--raio-g);
    background: var(--etiqueta);
    color: var(--etiqueta-texto);
  }
  [data-estado='certo'] .rotulo { background: var(--ok); color: var(--superficie); }
  [data-estado='certo'] .rotulo::before { content: '✓ ' / ''; }
  h3 { margin: 0.5rem 0 0; }
  .enunciado > :global(* + *) { margin-top: 0.8em; }
  .enunciado :global(p) { margin-bottom: 0; }
  .fonte { font-size: 0.8125rem; color: var(--texto-suave); text-align: right; font-style: italic; }

  .resposta { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem; font-size: 0.9375rem; }
  .resposta > label { display: grid; gap: 0.25rem; font-weight: 600; }
  .campo { display: flex; align-items: center; gap: 0.5rem; font-weight: 400; }
  input[type='text'] {
    min-height: 44px;
    width: 12rem;
    max-width: 100%;
    padding: 0 0.625rem;
    border: 2px solid var(--campo);
    border-radius: var(--raio-p);
    background: var(--superficie);
    color: var(--texto);
    font: 1rem var(--f-ui);
  }
  input[type='text']:focus-visible { border-color: var(--primaria); outline-offset: 2px; }
  [data-estado='errado'] input[type='text'] { border-color: var(--erro); }

  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 0.5rem; width: 100%; }
  legend { margin-bottom: 0.5rem; font-weight: 600; }
  .opcao {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 52px;
    padding: 0.5rem 1rem;
    border: 2px solid var(--campo);
    border-radius: var(--raio);
    background: var(--superficie);
    cursor: pointer;
  }
  .opcao:has(:checked) { border-color: var(--primaria); background: var(--pastilha); font-weight: 600; }
  .opcao:has(:focus-visible) { outline: 3px solid var(--primaria); outline-offset: 3px; }
  .opcao input { width: 1.125rem; height: 1.125rem; margin: 0; flex-shrink: 0; accent-color: var(--primaria); }
  .opcao input:focus-visible { outline: none; }
  [data-estado='certo'] .opcao:has(:checked) { border-color: var(--ok); background: var(--superficie); }
  [data-estado='errado'] .opcao:has(:checked) { border-color: var(--erro); background: var(--superficie); }

  button {
    min-height: 44px;
    padding: 0 1.375rem;
    border: 0;
    border-radius: var(--raio);
    background: var(--primaria);
    color: var(--primaria-texto);
    font: 700 0.9375rem var(--f-ui);
    cursor: pointer;
  }
  button:hover { background: var(--primaria-forte); }
  button:focus-visible { outline-color: var(--texto); }
  .feedback { margin: 0; width: 100%; min-height: 1.4em; font-weight: 700; }
  .feedback:empty { min-height: 0; }
  [data-estado='certo'] .feedback { color: var(--ok); }
  [data-estado='errado'] .feedback { color: var(--erro); }
  [data-estado='errado'] .feedback::before { content: '✕ ' / ''; }

  .resolucao { margin-top: 1rem; }
  .resolucao summary { display: inline-flex; align-items: center; min-height: 44px; cursor: pointer; font-weight: 600; color: var(--primaria); font-size: 0.9375rem; }
  .resolucao > div { margin-top: 0.5rem; padding: 0.875rem 1rem; border-radius: var(--raio-p); background: var(--superficie); }
  .resolucao[open] > div { animation: abrir 200ms ease-out; }
  @keyframes abrir { from { opacity: 0; transform: translateY(-4px); } }
  .resolucao :global(p) { margin-bottom: 0; }
  .resolucao > div > :global(* + *) { margin-top: 0.8em; }
  .pendente { font-size: 0.875rem; line-height: 1.5; color: var(--texto-suave); margin: 1rem 0 0; }

  @media print {
    .resolucao:not([open]) { display: none; }
  }
</style>
