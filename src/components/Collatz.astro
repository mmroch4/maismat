---
/** Calculadora da sequência de Collatz: escreve um número e vê o caminho até ao ciclo 4 → 2 → 1. */
interface Props {
  inicial?: number;
}
const { inicial = 17 } = Astro.props;
---

<maismat-collatz class="collatz">
  <label class="ui">
    <span>Escolhe um número natural</span>
    <input type="number" min="1" max="1000000000" value={inicial} inputmode="numeric" />
  </label>
  <p class="ui resumo" aria-live="polite"></p>
  <svg class="grafico" preserveAspectRatio="none" aria-hidden="true"></svg>
  <p class="sequencia"></p>
</maismat-collatz>

<script>
  class Collatz extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input')!;
      const resumo = this.querySelector('.resumo')!;
      const seq = this.querySelector('.sequencia')!;
      const svg = this.querySelector('svg')!;

      const atualizar = () => {
        const n0 = Math.floor(Number(input.value));
        if (!(n0 >= 1 && n0 <= 1e9)) { resumo.textContent = 'Escreve um número entre 1 e 1 000 000 000.'; return; }
        const s = [n0];
        while (s[s.length - 1] !== 1) {
          const n = s[s.length - 1];
          s.push(n % 2 === 0 ? n / 2 : 3 * n + 1);
        }
        const max = Math.max(...s);
        resumo.textContent = `Chegou a 1 em ${s.length - 1} passos. O maior valor atingido foi ${max.toLocaleString('pt-PT')}.`;
        seq.textContent = s.join(' → ');
        const w = 100, h = 40;
        const pts = s.map((v, i) => `${(i / Math.max(1, s.length - 1)) * w},${h - (v / max) * h}`).join(' ');
        svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
        svg.innerHTML = `<polyline points="${pts}" fill="none" stroke="currentColor" stroke-width="0.6" vector-effect="non-scaling-stroke" />`;
      };

      input.addEventListener('input', atualizar);
      atualizar();
    }
  }
  customElements.define('maismat-collatz', Collatz);
</script>

<style>
  .collatz { display: block; background: var(--dourado-claro); border-radius: var(--raio); padding: 1.25rem; margin: 2rem 0; }
  label { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; font-weight: 600; font-size: 0.95rem; }
  input { font: inherit; width: 9rem; padding: 0.4rem 0.6rem; border: 1px solid var(--campo); border-radius: 6px; background: var(--superficie); color: var(--texto); }
  .resumo { font-size: 0.9rem; margin: 0.75rem 0; }
  .grafico { width: 100%; height: 7rem; color: var(--azul); background: var(--superficie); border-radius: 6px; }
  .sequencia { font-size: 0.85rem; line-height: 1.6; word-break: break-word; color: var(--texto-suave); margin: 0.75rem 0 0; max-height: 9rem; overflow-y: auto; }
</style>
