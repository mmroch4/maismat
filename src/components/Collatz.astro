---
/** Collatz sequence calculator: type a number and see its path down to the 4 → 2 → 1 cycle. */
interface Props {
  start?: number;
}
const { start = 17 } = Astro.props;
---

<maismat-collatz class="collatz">
  <label class="ui">
    <span>Escolhe um número natural</span>
    <input type="number" min="1" max="1000000000" value={start} inputmode="numeric" />
  </label>
  <p class="ui summary" aria-live="polite"></p>
  <svg class="chart" preserveAspectRatio="none" aria-hidden="true"></svg>
  <p class="sequence"></p>
</maismat-collatz>

<script>
  const MAX_START = 1e9;

  class Collatz extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input')!;
      const summary = this.querySelector('.summary')!;
      const sequenceText = this.querySelector('.sequence')!;
      const svg = this.querySelector('svg')!;

      const update = () => {
        const start = Math.floor(Number(input.value));
        if (!(start >= 1 && start <= MAX_START)) {
          summary.textContent = 'Escreve um número entre 1 e 1 000 000 000.';
          return;
        }
        const sequence = [start];
        while (sequence.at(-1) !== 1) {
          const n = sequence.at(-1)!;
          sequence.push(n % 2 === 0 ? n / 2 : 3 * n + 1);
        }
        const max = Math.max(...sequence);
        summary.textContent = `Chegou a 1 em ${sequence.length - 1} passos. O maior valor atingido foi ${max.toLocaleString('pt-PT')}.`;
        sequenceText.textContent = sequence.join(' → ');
        const width = 100;
        const height = 40;
        const points = sequence
          .map((value, i) => `${(i / Math.max(1, sequence.length - 1)) * width},${height - (value / max) * height}`)
          .join(' ');
        svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
        svg.innerHTML = `<polyline points="${points}" fill="none" stroke="currentColor" stroke-width="0.6" vector-effect="non-scaling-stroke" />`;
      };

      input.addEventListener('input', update);
      update();
    }
  }
  customElements.define('maismat-collatz', Collatz);
</script>

<style>
  .collatz {
    display: block;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border-top: 6px solid var(--tag);
    padding: 1.25rem;
    margin: 2rem 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  input {
    width: 9rem;
    min-height: 44px;
    padding: 0 0.625rem;
    border: 2px solid var(--field-border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: 1rem var(--font-ui);
  }
  input:focus-visible {
    border-color: var(--primary);
    outline-offset: 2px;
  }
  .summary {
    font-size: 0.9rem;
    margin: 0.75rem 0;
  }
  .chart {
    width: 100%;
    height: 7rem;
    color: var(--primary);
    background: var(--bg);
    border-radius: var(--radius-sm);
  }
  .sequence {
    font-size: 0.85rem;
    line-height: 1.6;
    word-break: break-word;
    color: var(--text-muted);
    margin: 0.75rem 0 0;
    max-height: 9rem;
    overflow-y: auto;
  }
</style>
