---
// Search field of /pesquisa/ and of the 404 page. Whatever comes in the slot goes below the field (the filters).
interface Props {
  hidden?: boolean;
}
const { hidden = false } = Astro.props;
---

<form class="ui search-form" action="/pesquisa/" method="get" role="search" hidden={hidden}>
  <label for="q">O que procuras?</label>
  <div class="row">
    <input id="q" type="search" name="q" autocomplete="off" spellcheck="false" />
    <button type="submit">Pesquisar</button>
  </div>
  <slot />
</form>

<style>
  .search-form {
    display: grid;
    gap: 0.375rem;
    max-width: 40rem;
    font-size: 0.9375rem;
  }
  .search-form[hidden] {
    display: none;
  }
  label {
    font-weight: 600;
  }
  .row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  input {
    flex: 1 1 12rem;
    min-width: 0;
    min-height: 52px;
    padding: 0 0.875rem;
    border: 2px solid var(--field-border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: 1rem var(--font-ui);
  }
  input:focus-visible {
    border-color: var(--primary);
    outline-offset: 2px;
  }
  button {
    flex: 1 1 auto;
    max-width: 100%;
    min-height: 52px;
    padding: 0 1.375rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--on-primary);
    font: 700 0.9375rem var(--font-ui);
    cursor: pointer;
  }
  @media (min-width: 769px) {
    button {
      flex: 0 0 auto;
    }
  }
  button:hover {
    background: var(--primary-strong);
  }
  button:focus-visible {
    outline-color: var(--text);
  }
</style>
