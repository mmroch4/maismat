---
import { Image } from 'astro:assets';
import { getIssueArticles, monthYear, type Issue } from '../lib/issues';

interface Props {
  edicao: Issue;
}
const { edicao } = Astro.props;
const { capa, data, convertida, numero } = edicao.data;
const artigos = convertida ? (await getIssueArticles(edicao.id)).length : 0;
---

<a class="capa-edicao" href={`/edicoes/${edicao.id}/`}>
  {capa && <Image src={capa} alt={`Capa da edição de ${monthYear(data)}`} width={360} />}
  <span class="mes ui cap">{monthYear(data)}</span>
  <span class="ui rotulo">
    Edição {String(numero).padStart(2, '0')}
    {artigos > 0 && ` · ${artigos} artigos`}
  </span>
  {!convertida && <span class="ui so-pdf">PDF</span>}
</a>

<style>
  .capa-edicao {
    display: grid;
    gap: 0.125rem;
    align-content: start;
    text-decoration: none;
    color: var(--texto);
    position: relative;
  }
  img {
    width: 100%;
    aspect-ratio: 210 / 297;
    object-fit: cover;
    border-radius: var(--raio-p);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
    transition: transform 150ms ease;
    margin-bottom: 0.5rem;
  }
  .capa-edicao:hover img {
    transform: translateY(-2px);
  }
  .mes {
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .rotulo {
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  .so-pdf {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    background: var(--superficie);
    color: var(--texto);
    padding: 0.125rem 0.5rem;
    border-radius: var(--raio-g);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }
</style>
