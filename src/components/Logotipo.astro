---
// O «+MAT» em contornos (src/lib/logo.ts): segue a cor do texto e não precisa da Playfair.
import { viewBox, outline } from '../lib/logo';
---

<svg class="logotipo" viewBox={viewBox} aria-hidden="true" focusable="false">
  <path d={outline} fill="currentColor" />
</svg>

<style>
  .logotipo {
    display: block;
    height: 1em;
    width: auto;
  }
</style>
