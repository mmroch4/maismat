---
// O «+MAT» em contornos (src/lib/logotipo.ts): segue a cor do texto e não precisa da Playfair.
import { caixa, contorno } from '../lib/logotipo';
---

<svg class="logotipo" viewBox={caixa} aria-hidden="true" focusable="false"><path d={contorno} fill="currentColor" /></svg>

<style>
  .logotipo { display: block; height: 1em; width: auto; }
</style>
