---
// Campo de pesquisa da /pesquisa/ e da página 404. O que vier no slot fica por baixo do campo (os filtros).
interface Props { escondido?: boolean }
const { escondido = false } = Astro.props;
---

<form class="ui pesquisa" action="/pesquisa/" method="get" role="search" hidden={escondido}>
  <label for="q">O que procuras?</label>
  <div class="linha">
    <input id="q" type="search" name="q" autocomplete="off" spellcheck="false" />
    <button type="submit">Pesquisar</button>
  </div>
  <slot />
</form>

<style>
  .pesquisa { display: grid; gap: 0.375rem; max-width: 40rem; font-size: 0.9375rem; }
  .pesquisa[hidden] { display: none; }
  label { font-weight: 600; }
  .linha { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  input {
    flex: 1 1 12rem;
    min-width: 0;
    min-height: 52px;
    padding: 0 0.875rem;
    border: 2px solid var(--campo);
    border-radius: var(--raio);
    background: var(--superficie);
    color: var(--texto);
    font: 1rem var(--f-ui);
  }
  input:focus-visible { border-color: var(--primaria); outline-offset: 2px; }
  button {
    flex: 1 1 auto;
    max-width: 100%;
    min-height: 52px;
    padding: 0 1.375rem;
    border: 0;
    border-radius: var(--raio);
    background: var(--primaria);
    color: var(--primaria-texto);
    font: 700 0.9375rem var(--f-ui);
    cursor: pointer;
  }
  @media (min-width: 769px) { button { flex: 0 0 auto; } }
  button:hover { background: var(--primaria-forte); }
  button:focus-visible { outline-color: var(--texto); }
</style>
