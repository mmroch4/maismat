---
import Base from '../../layouts/Base.astro';
import { getPublishedArticles } from '../../lib/issues';
import { SECTIONS, type SectionId } from '../../lib/sections';

const articles = await getPublishedArticles();
const articleCount = (section: SectionId) => articles.filter((article) => article.data.seccao === section).length;
const sections = (Object.keys(SECTIONS) as SectionId[]).filter((section) => articleCount(section) > 0);
---

<Base title="Secções">
  <div class="container">
    <div class="page-header">
      <h1>
        <span class="highlight">Secções</span>
      </h1>
      <p>Os artigos do +MAT arrumados pelas secções do jornal.</p>
    </div>
    <ul class="ui">
      {sections.map((section) => (
        <li>
          <a class="card" href={`/seccoes/${section}/`}>
            <span class="name">{SECTIONS[section]}</span>{' '}
            <span class="count">{articleCount(section) === 1 ? '1 artigo' : `${articleCount(section)} artigos`}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
  }
  .card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 56px;
    padding: 0.75rem 1.25rem;
  }
  .name {
    font-weight: 700;
  }
  .count {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
