---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedArticles, monthYear, issueLabel, articleSlug } from '../../lib/issues';
import { SECTIONS, SECTION_IDS, type SectionId } from '../../lib/sections';

export function getStaticPaths() {
  return SECTION_IDS.map((seccao) => ({ params: { seccao } }));
}

const seccao = Astro.params.seccao as SectionId;
const artigos = await Promise.all(
  (await getPublishedArticles((a) => a.data.seccao === seccao)).map(async (a) => ({
    a,
    e: (await getEntry(a.data.edicao))!,
  })),
);
artigos.sort((x, y) => y.e.data.data.getTime() - x.e.data.data.getTime() || x.a.data.ordem - y.a.data.ordem);
---

<Base titulo={SECTIONS[seccao]}>
  <div class="contentor">
    <div class="cabeca">
      <p class="ui">
        <a href="/seccoes/">← Todas as secções</a>
      </p>
      <h1>{SECTIONS[seccao]}</h1>
    </div>
    {artigos.length === 0 && <p>Ainda não há artigos nesta secção na versão digital.</p>}
    <ul>
      {artigos.map(({ a, e }) => (
        <li>
          <a class="cartao" href={`/edicoes/${e.id}/${articleSlug(a)}/`}>
            <span class="ui quando">
              {issueLabel(e)} · <span class="cap">{monthYear(e.data.data)}</span>
            </span>
            <strong class="ui">{a.data.titulo}</strong>
            {a.data.resumo && <span class="resumo">{a.data.resumo}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .cabeca p {
    margin: 0 0 0.75rem;
  }
  .cabeca a {
    color: var(--texto-suave);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    max-width: var(--leitura);
  }
  .cartao {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
  }
  .quando {
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  strong {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .resumo {
    font-size: 0.9375rem;
    color: var(--texto-suave);
    line-height: 1.45;
  }
</style>
