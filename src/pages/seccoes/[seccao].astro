---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { artigosPublicados, mesAno, rotuloEdicao, slugArtigo } from '../../lib/edicoes';
import { SECCOES, SECCAO_IDS, type Seccao } from '../../lib/seccoes';

export function getStaticPaths() {
  return SECCAO_IDS.map((seccao) => ({ params: { seccao } }));
}

const seccao = Astro.params.seccao as Seccao;
const artigos = await Promise.all(
  (await artigosPublicados((a) => a.data.seccao === seccao)).map(async (a) => ({
    a,
    e: (await getEntry(a.data.edicao))!,
  })),
);
artigos.sort((x, y) => y.e.data.data.getTime() - x.e.data.data.getTime() || x.a.data.ordem - y.a.data.ordem);
---

<Base titulo={SECCOES[seccao]}>
  <div class="contentor">
    <div class="cabeca">
      <p class="ui">
        <a href="/seccoes/">← Todas as secções</a>
      </p>
      <h1>{SECCOES[seccao]}</h1>
    </div>
    {artigos.length === 0 && <p>Ainda não há artigos nesta secção na versão digital.</p>}
    <ul>
      {artigos.map(({ a, e }) => (
        <li>
          <a class="cartao" href={`/edicoes/${e.id}/${slugArtigo(a)}/`}>
            <span class="ui quando">
              {rotuloEdicao(e)} · <span class="cap">{mesAno(e.data.data)}</span>
            </span>
            <strong class="ui">{a.data.titulo}</strong>
            {a.data.resumo && <span class="resumo">{a.data.resumo}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .cabeca p {
    margin: 0 0 0.75rem;
  }
  .cabeca a {
    color: var(--texto-suave);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    max-width: var(--leitura);
  }
  .cartao {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
  }
  .quando {
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  strong {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .resumo {
    font-size: 0.9375rem;
    color: var(--texto-suave);
    line-height: 1.45;
  }
</style>
