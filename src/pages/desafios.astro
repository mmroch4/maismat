---
import Base from '../layouts/Base.astro';
import AnelProgresso from '../components/AnelProgresso.astro';
import { getPublishedChallenges } from '../lib/challenges';
import { monthYear, issueLabel } from '../lib/issues';

const desafios = await getPublishedChallenges();
const porEdicao = [...Map.groupBy(desafios, (d) => d.issue)];
---

<Base
  titulo="Arquivo de desafios"
  descricao="Todos os desafios publicados no +MAT, para voltares a encontrá-los e resolvê-los."
>
  <div class="contentor">
    <div class="cabeca">
      <h1>
        Arquivo de <span class="marcador">desafios</span>
      </h1>
      <p>
        Os {desafios.length} desafios publicados no +MAT, da edição mais recente para a mais antiga. Cada um leva-te ao
        artigo onde podes responder e, quando existe, ver a resolução.
      </p>
    </div>

    <div class="cartao progresso nao-imprimir">
      <AnelProgresso ids={desafios.map((d) => d.id)} />
      <span class="ui neste">neste aparelho</span>
    </div>

    <form class="ui filtros nao-imprimir" hidden>
      <div class="pastilhas" role="group" aria-label="Estado">
        <button type="button" data-estado="por-resolver" aria-pressed="false">
          Por resolver · <span class="n"></span>
        </button>
        <button type="button" data-estado="resolvidos" aria-pressed="false">
          Resolvidos · <span class="n"></span>
        </button>
        <button type="button" data-estado="" aria-pressed="true">
          Todos · <span class="n"></span>
        </button>
      </div>
      <label>
        <span>Edição</span>
        <select name="edicao" class="entrada">
          <option value="">Todas</option>
          {porEdicao.map(([e]) => (
            <option value={e.id}>{issueLabel(e)}</option>
          ))}
        </select>
      </label>
      <p class="contagem" role="status" aria-live="polite"></p>
    </form>

    <details id="levar" class="ui transferir nao-imprimir" hidden>
      <summary>Levar o teu progresso para outro computador</summary>
      <p>
        Os computadores da escola apagam muitas vezes o que fica guardado. Cria um código, envia-o a ti próprio (por
        email, no Teams ou num documento) e cola-o no outro computador. O código só diz que desafios resolveste: não tem
        o teu nome nem as tuas respostas.
      </p>
      <div class="passos">
        <form class="exportar">
          <p class="passo">Neste computador</p>
          <button type="submit">Criar o meu código</button>
          <label hidden>
            <span>O teu código</span>
            <textarea name="codigo" rows="3" readonly spellcheck="false"></textarea>
          </label>
          <button type="button" class="copiar" hidden>
            Copiar
          </button>
          <p class="mensagem" role="status" aria-live="polite"></p>
          <div class="qr" hidden>
            <p class="passo">Para o telemóvel</p>
            <div class="qr-imagem"></div>
            <p>Lê com a câmara do telemóvel.</p>
            <p class="ligacao">
              Ou abre esta ligação: <a href=""></a>
            </p>
          </div>
        </form>
        <form class="importar">
          <p class="passo">No outro computador</p>
          <label>
            <span>Cola aqui o teu código</span>
            <textarea name="codigo" rows="3" spellcheck="false" autocomplete="off"></textarea>
          </label>
          <button type="submit">Juntar ao meu progresso</button>
          <p class="mensagem" role="status" aria-live="polite"></p>
          <div class="confirmar" hidden>
            <p class="pergunta" tabindex="-1"></p>
            <button type="button" class="sim">
              Juntar
            </button>
            <button type="button" class="nao">
              Agora não
            </button>
          </div>
        </form>
      </div>
    </details>

    {porEdicao.map(([e, lista]) => (
      <section class="edicao" data-edicao={e.id} aria-labelledby={`ed-${e.id}`}>
        <h2 id={`ed-${e.id}`}>
          <span class="cap">{monthYear(e.data.data)}</span> <span class="ui">· {issueLabel(e)}</span>
        </h2>
        <ul>
          {lista.map((d) => (
            <li class="desafio" data-id={d.id}>
              <p class="ui rotulo">
                <span>
                  Desafio{d.number && ` ${d.number}`} · {d.article.data.titulo}
                </span>
                <span class="resolvido" hidden>
                  <span aria-hidden="true">✓</span> Resolvido
                </span>
              </p>
              <h3>
                <a href={d.url}>{d.title}</a>
              </h3>
              {d.excerpt.length > 0 && (
                <p class="excerto">{d.excerpt.map((s) => ('html' in s ? <Fragment set:html={s.html} /> : s.text))}</p>
              )}
              {(d.hasAnswer || d.hasSolution) && (
                <p class="ui etiquetas">
                  {d.hasAnswer && <span>Com verificação</span>}
                  {d.hasSolution && <span>Com resolução</span>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<script>
  import { encode } from 'uqr';
  import { CHALLENGE_ID, codeFromLink, decodeProgress, encodeProgress, progressLink } from '../lib/progress-code';

  const form = document.querySelector<HTMLFormElement>('.filtros')!;
  const contagem = form.querySelector<HTMLElement>('.contagem')!;
  const seccoes = [...document.querySelectorAll<HTMLElement>('.edicao')];
  const itens = [...document.querySelectorAll<HTMLElement>('.desafio')];

  // Mesma chave que o Desafio.astro grava quando um aluno acerta.
  const resolvido = (id: string) => {
    try {
      return localStorage.getItem(`maismat:${id}`) === 'ok';
    } catch {
      return false;
    }
  };

  // Por id: um desafio republicado (por exemplo, nas resoluções) conta uma vez só.
  const resolvidos = new Set<string>();
  function marcar() {
    for (const li of itens) {
      if (!resolvido(li.dataset.id!)) continue;
      li.dataset.resolvido = '';
      li.querySelector<HTMLElement>('.resolvido')!.hidden = false;
      resolvidos.add(li.dataset.id!);
    }
  }
  marcar();

  const botoes = [...form.querySelectorAll<HTMLButtonElement>('[data-estado]')];
  let estado = '';
  for (const b of botoes)
    b.addEventListener('click', () => {
      estado = b.dataset.estado!;
      for (const o of botoes) o.setAttribute('aria-pressed', String(o === b));
      filtrar();
    });

  function filtrar() {
    const edicao = form.edicao.value;
    const contagens: Record<string, number> = { '': itens.length, resolvidos: 0, 'por-resolver': 0 };
    for (const li of itens) contagens['resolvido' in li.dataset ? 'resolvidos' : 'por-resolver']++;
    for (const b of botoes) b.querySelector('.n')!.textContent = String(contagens[b.dataset.estado!]);
    let visiveis = 0;
    for (const s of seccoes) {
      let algum = false;
      for (const li of s.querySelectorAll<HTMLElement>('.desafio')) {
        const r = 'resolvido' in li.dataset;
        li.hidden = (estado === 'resolvidos' && !r) || (estado === 'por-resolver' && r);
        if (!li.hidden) algum = true;
        if (!li.hidden && (!edicao || s.dataset.edicao === edicao)) visiveis++;
      }
      s.hidden = !algum || (edicao !== '' && s.dataset.edicao !== edicao);
    }
    contagem.textContent = `A mostrar ${visiveis} de ${itens.length} desafios · resolveste ${resolvidos.size}.`;
  }

  form.addEventListener('change', filtrar);
  form.addEventListener('submit', (e) => e.preventDefault());
  // A contagem é preenchida antes de o formulário aparecer, para não ser anunciada ao abrir a página.
  filtrar();
  form.hidden = false;

  const transferir = document.querySelector<HTMLDetailsElement>('.transferir')!;
  const exportar = transferir.querySelector<HTMLFormElement>('.exportar')!;
  const importar = transferir.querySelector<HTMLFormElement>('.importar')!;
  const copiar = exportar.querySelector<HTMLButtonElement>('.copiar')!;
  const qr = exportar.querySelector<HTMLElement>('.qr')!;
  const confirmar = importar.querySelector<HTMLElement>('.confirmar')!;
  const conhecidos = new Set(itens.map((li) => li.dataset.id!));
  const plural = (n: number, um: string, varios: string) => (n === 1 ? `1 ${um}` : `${n} ${varios}`);

  function avisar(f: HTMLFormElement, texto: string, erro = false) {
    const m = f.querySelector<HTMLElement>('.mensagem')!;
    m.textContent = texto;
    m.classList.toggle('erro', erro);
  }

  exportar.addEventListener('submit', (e) => {
    e.preventDefault();
    const ids: string[] = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i) ?? '';
        const id = k.slice('maismat:'.length);
        if (k.startsWith('maismat:') && CHALLENGE_ID.test(id) && localStorage.getItem(k) === 'ok') ids.push(id);
      }
    } catch {
      return avisar(exportar, 'Este browser não deixa ler o progresso guardado.', true);
    }
    if (!ids.length) return avisar(exportar, 'Ainda não resolveste nenhum desafio neste computador.', true);
    exportar.codigo.value = encodeProgress(ids);
    exportar.codigo.closest('label')!.hidden = false;
    copiar.hidden = false;
    desenharQr(progressLink(location.origin, ids));
    exportar.codigo.select();
    avisar(
      exportar,
      `Código criado com ${plural(ids.length, 'desafio resolvido', 'desafios resolvidos')}. Copia-o e guarda-o.`,
    );
  });

  copiar.addEventListener('click', async () => {
    exportar.codigo.select();
    try {
      await navigator.clipboard.writeText(exportar.codigo.value);
      avisar(exportar, 'Código copiado. Cola-o num email, no Teams ou num documento.');
    } catch {
      avisar(exportar, 'Não consegui copiar sozinho. O código está selecionado: copia-o com Ctrl+C.');
    }
  });

  // Um caminho por linha de módulos pretos; o fundo branco (com a margem de 4 módulos) é fixo, também no modo escuro.
  function desenharQr(url: string) {
    const { data, size } = encode(url, { ecc: 'L', border: 4 });
    let d = '';
    data.forEach((linha, y) => {
      for (let x = 0; x < size; x++) {
        if (!linha[x]) continue;
        const inicio = x;
        while (linha[x + 1]) x++;
        d += `M${inicio} ${y}h${x - inicio + 1}v1H${inicio}z`;
      }
    });
    qr.querySelector('.qr-imagem')!.innerHTML =
      `<svg role="img" aria-label="Código QR com a ligação para levar o teu progresso para o telemóvel" viewBox="0 0 ${size} ${size}" shape-rendering="crispEdges">` +
      `<rect width="${size}" height="${size}" fill="#fff"/><path d="${d}" fill="#000"/></svg>`;
    const a = qr.querySelector<HTMLAnchorElement>('.ligacao a')!;
    a.href = url;
    a.textContent = url;
    qr.hidden = false;
  }

  const novosDe = (ids: string[]) => ids.filter((id) => conhecidos.has(id) && !resolvido(id));

  function juntar(ids: string[]) {
    confirmar.hidden = true;
    const novos = novosDe(ids);
    const ignorados = ids.filter((id) => !conhecidos.has(id)).length;
    try {
      for (const id of novos) if (CHALLENGE_ID.test(id)) localStorage.setItem(`maismat:${id}`, 'ok');
    } catch {
      return avisar(importar, 'Este browser não deixa guardar o progresso.', true);
    }
    marcar();
    filtrar();
    document.dispatchEvent(new Event('maismat:progresso'));
    const partes = [
      novos.length
        ? `Juntámos ${plural(novos.length, 'desafio', 'desafios')} ao teu progresso.`
        : 'Já tinhas todos os desafios deste código.',
      `Agora tens ${plural(resolvidos.size, 'resolvido', 'resolvidos')}.`,
    ];
    if (ignorados)
      partes.push(
        `${plural(ignorados, 'desafio do código não existe', 'desafios do código não existem')} neste site e ${ignorados === 1 ? 'foi ignorado' : 'foram ignorados'}.`,
      );
    avisar(importar, partes.join(' '));
  }

  importar.addEventListener('submit', (e) => {
    e.preventDefault();
    try {
      juntar(decodeProgress(importar.codigo.value));
    } catch (erro) {
      confirmar.hidden = true;
      avisar(importar, (erro as Error).message, true);
    }
  });

  transferir.hidden = false;

  // Ligação do QR (/desafios/#progresso=MAT1-…): preenche o campo e pergunta antes de escrever.
  // Também com a página já aberta, porque aí o browser só muda o fragmento.
  const pergunta = confirmar.querySelector<HTMLElement>('.pergunta')!;
  let aConfirmar: string[] = [];
  confirmar.querySelector('.sim')!.addEventListener('click', () => juntar(aConfirmar));
  confirmar.querySelector('.nao')!.addEventListener('click', () => {
    confirmar.hidden = true;
    avisar(importar, 'Não juntámos nada. O código ficou no campo, se mudares de ideias.');
  });

  function lerFragmento() {
    // Da folha «Mais»: abre o painel para levar o progresso.
    if (location.hash === '#levar') {
      transferir.open = true;
      return transferir.scrollIntoView({ block: 'start' });
    }
    const codigo = codeFromLink(location.hash);
    if (codigo === null) return;
    history.replaceState(null, '', location.pathname + location.search);
    transferir.open = true;
    importar.codigo.value = codigo;
    confirmar.hidden = true;
    avisar(importar, '');
    transferir.scrollIntoView({ block: 'start' });
    let ids: string[];
    try {
      ids = decodeProgress(codigo);
    } catch (erro) {
      return avisar(importar, (erro as Error).message, true);
    }
    const n = novosDe(ids).length;
    if (!n) return juntar(ids);
    aConfirmar = ids;
    pergunta.textContent = `Juntar ${plural(n, 'desafio', 'desafios')} ao teu progresso?`;
    confirmar.hidden = false;
    pergunta.focus();
  }
  lerFragmento();
  addEventListener('hashchange', lerFragmento);
</script>

<style>
  .progresso {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    max-width: 30rem;
  }
  .neste {
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem 1.25rem;
    margin: 1.5rem 0 0.5rem;
    font-size: 0.9375rem;
  }
  .filtros label {
    display: grid;
    gap: 0.25rem;
  }
  .filtros label > span {
    font-weight: 600;
  }
  .contagem {
    margin: 0;
    color: var(--texto-suave);
    flex-basis: 100%;
  }

  h2 {
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--linha);
  }
  h2 .ui {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--texto-suave);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .desafio {
    padding: 1rem 1.25rem;
    min-width: 0;
    background: var(--superficie);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
  }
  .desafio[data-resolvido] {
    box-shadow: 0 0 0 2px var(--ok);
  }
  .rotulo {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--texto-suave);
    margin: 0;
  }
  .rotulo .resolvido {
    color: var(--ok);
    white-space: nowrap;
  }
  h3 {
    margin: 0.375rem 0 0;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--texto);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .excerto {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--texto-suave);
    margin: 0.5rem 0 0;
    overflow-wrap: anywhere;
  }
  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .etiquetas span {
    padding: 0.2rem 0.625rem;
    border-radius: var(--raio-g);
    background: var(--pastilha);
    color: var(--texto-suave);
  }
  [hidden] {
    display: none !important;
  }

  .transferir {
    margin: 1rem 0 0.5rem;
    border-radius: var(--raio);
    background: var(--superficie);
    box-shadow: var(--sombra);
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    max-width: 48rem;
  }
  .transferir summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-weight: 600;
    color: var(--primaria);
  }
  .transferir > p {
    color: var(--texto-suave);
    margin: 0.75rem 0 0;
  }
  .passos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem 1.5rem;
    margin-top: 1rem;
  }
  .passos form {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    align-content: start;
    gap: 0.6rem;
    min-width: 0;
  }
  .passo {
    font-weight: 600;
    margin: 0;
    width: 100%;
  }
  .passos label {
    display: grid;
    gap: 0.25rem;
    width: 100%;
  }
  .passos label span {
    color: var(--texto-suave);
  }
  textarea {
    font:
      0.85rem/1.4 ui-monospace,
      monospace;
    padding: 0.45rem 0.6rem;
    border: 2px solid var(--campo);
    border-radius: var(--raio-p);
    background: var(--fundo);
    color: var(--texto);
    width: 100%;
    resize: vertical;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .passos button {
    min-height: 44px;
    padding: 0 1.125rem;
    border: 0;
    border-radius: var(--raio);
    background: var(--primaria);
    color: var(--primaria-texto);
    font: 700 0.875rem var(--f-ui);
    cursor: pointer;
  }
  .passos button:hover {
    background: var(--primaria-forte);
  }
  .passos button:focus-visible {
    outline-color: var(--texto);
  }
  .mensagem {
    margin: 0;
    width: 100%;
    min-height: 1.4em;
    color: var(--ok);
    font-weight: 600;
  }
  .mensagem.erro {
    color: var(--erro);
  }
  .mensagem:empty {
    min-height: 0;
  }

  .qr,
  .confirmar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    width: 100%;
  }
  .qr p,
  .confirmar p {
    margin: 0;
    width: 100%;
  }
  .qr-imagem {
    width: 100%;
    max-width: 16rem;
  }
  .qr-imagem :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    outline: 1px solid var(--linha);
  }
  .ligacao {
    color: var(--texto-suave);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .pergunta {
    font-weight: 600;
  }
  .passos .nao {
    background: none;
    color: var(--texto);
    box-shadow: inset 0 0 0 2px var(--campo);
  }
  .passos .nao:hover {
    background: var(--fundo);
  }
</style>
