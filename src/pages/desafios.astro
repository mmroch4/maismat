---
import Base from '../layouts/Base.astro';
import { desafiosPublicados } from '../lib/desafios';
import { mesAno, rotuloEdicao } from '../lib/edicoes';

const desafios = await desafiosPublicados();
const porEdicao = [...Map.groupBy(desafios, (d) => d.edicao)];
---

<Base titulo="Arquivo de desafios" descricao="Todos os desafios publicados no +MAT, para voltares a encontrá-los e resolvê-los.">
  <div class="contentor">
    <h1>Arquivo de desafios</h1>
    <p class="ui intro">
      Os {desafios.length} desafios publicados no +MAT, da edição mais recente para a mais antiga.
      Cada um leva-te ao artigo onde podes responder e, quando existe, ver a resolução.
    </p>

    <form class="ui filtros nao-imprimir" hidden>
      <label>
        <span>Edição</span>
        <select name="edicao">
          <option value="">Todas</option>
          {porEdicao.map(([e]) => <option value={e.id}>{rotuloEdicao(e)}</option>)}
        </select>
      </label>
      <label>
        <span>Estado</span>
        <select name="estado">
          <option value="">Todos</option>
          <option value="por-resolver">Por resolver</option>
          <option value="resolvidos">Resolvidos por ti</option>
        </select>
      </label>
      <p class="contagem" role="status" aria-live="polite"></p>
    </form>

    <details class="ui transferir nao-imprimir" hidden>
      <summary>Levar o teu progresso para outro computador</summary>
      <p>
        Os computadores da escola apagam muitas vezes o que fica guardado. Cria um código, envia-o a ti próprio
        (por email, no Teams ou num documento) e cola-o no outro computador. O código só diz que desafios
        resolveste: não tem o teu nome nem as tuas respostas.
      </p>
      <div class="passos">
        <form class="exportar">
          <p class="passo">Neste computador</p>
          <button type="submit">Criar o meu código</button>
          <label hidden>
            <span>O teu código</span>
            <textarea name="codigo" rows="3" readonly spellcheck="false"></textarea>
          </label>
          <button type="button" class="copiar" hidden>Copiar</button>
          <p class="mensagem" role="status" aria-live="polite"></p>
        </form>
        <form class="importar">
          <p class="passo">No outro computador</p>
          <label>
            <span>Cola aqui o teu código</span>
            <textarea name="codigo" rows="3" spellcheck="false" autocomplete="off"></textarea>
          </label>
          <button type="submit">Juntar ao meu progresso</button>
          <p class="mensagem" role="status" aria-live="polite"></p>
        </form>
      </div>
    </details>

    {porEdicao.map(([e, lista]) => (
      <section class="edicao" data-edicao={e.id} aria-labelledby={`ed-${e.id}`}>
        <h2 id={`ed-${e.id}`}>
          {rotuloEdicao(e)} <span class="ui">· <span class="cap">{mesAno(e.data.data)}</span></span>
        </h2>
        <ul>
          {lista.map((d) => (
            <li class="desafio" data-id={d.id}>
              <p class="ui rotulo">
                Desafio{d.numero && ` ${d.numero}`} · {rotuloEdicao(e)} · {d.artigo.data.titulo}
              </p>
              <h3><a href={d.url}>{d.titulo}</a></h3>
              {d.excerto.length > 0 && (
                <p class="excerto">{d.excerto.map((s) => ('html' in s ? <Fragment set:html={s.html} /> : s.texto))}</p>
              )}
              <p class="ui etiquetas">
                <span class="resolvido" hidden>Resolvido por ti <span aria-hidden="true">✓</span></span>
                {d.temResposta && <span>Com verificação</span>}
                {d.temResolucao && <span>Com resolução</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<script>
  import { ID, codificar, descodificar } from '../lib/progresso.mjs';

  const form = document.querySelector<HTMLFormElement>('.filtros')!;
  const contagem = form.querySelector<HTMLElement>('.contagem')!;
  const seccoes = [...document.querySelectorAll<HTMLElement>('.edicao')];
  const itens = [...document.querySelectorAll<HTMLElement>('.desafio')];

  // Mesma chave que o Desafio.astro grava quando um aluno acerta.
  const resolvido = (id: string) => {
    try {
      return localStorage.getItem(`maismat:${id}`) === 'ok';
    } catch {
      return false;
    }
  };

  // Por id: um desafio republicado (por exemplo, nas resoluções) conta uma vez só.
  const resolvidos = new Set<string>();
  function marcar() {
    for (const li of itens) {
      if (!resolvido(li.dataset.id!)) continue;
      li.dataset.resolvido = '';
      li.querySelector<HTMLElement>('.resolvido')!.hidden = false;
      resolvidos.add(li.dataset.id!);
    }
  }
  marcar();

  function filtrar() {
    const edicao = form.edicao.value;
    const estado = form.estado.value;
    let visiveis = 0;
    for (const s of seccoes) {
      let algum = false;
      for (const li of s.querySelectorAll<HTMLElement>('.desafio')) {
        const r = 'resolvido' in li.dataset;
        li.hidden = (estado === 'resolvidos' && !r) || (estado === 'por-resolver' && r);
        if (!li.hidden) algum = true;
        if (!li.hidden && (!edicao || s.dataset.edicao === edicao)) visiveis++;
      }
      s.hidden = !algum || (edicao !== '' && s.dataset.edicao !== edicao);
    }
    contagem.textContent = `A mostrar ${visiveis} de ${itens.length} desafios · resolveste ${resolvidos.size}.`;
  }

  form.addEventListener('change', filtrar);
  form.addEventListener('submit', (e) => e.preventDefault());
  // A contagem é preenchida antes de o formulário aparecer, para não ser anunciada ao abrir a página.
  filtrar();
  form.hidden = false;

  const transferir = document.querySelector<HTMLDetailsElement>('.transferir')!;
  const exportar = transferir.querySelector<HTMLFormElement>('.exportar')!;
  const importar = transferir.querySelector<HTMLFormElement>('.importar')!;
  const copiar = exportar.querySelector<HTMLButtonElement>('.copiar')!;
  const conhecidos = new Set(itens.map((li) => li.dataset.id!));
  const plural = (n: number, um: string, varios: string) => (n === 1 ? `1 ${um}` : `${n} ${varios}`);

  function avisar(f: HTMLFormElement, texto: string, erro = false) {
    const m = f.querySelector<HTMLElement>('.mensagem')!;
    m.textContent = texto;
    m.classList.toggle('erro', erro);
  }

  exportar.addEventListener('submit', (e) => {
    e.preventDefault();
    const ids: string[] = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i) ?? '';
        const id = k.slice('maismat:'.length);
        if (k.startsWith('maismat:') && ID.test(id) && localStorage.getItem(k) === 'ok') ids.push(id);
      }
    } catch {
      return avisar(exportar, 'Este browser não deixa ler o progresso guardado.', true);
    }
    if (!ids.length) return avisar(exportar, 'Ainda não resolveste nenhum desafio neste computador.', true);
    exportar.codigo.value = codificar(ids);
    exportar.codigo.closest('label')!.hidden = false;
    copiar.hidden = false;
    exportar.codigo.select();
    avisar(exportar, `Código criado com ${plural(ids.length, 'desafio resolvido', 'desafios resolvidos')}. Copia-o e guarda-o.`);
  });

  copiar.addEventListener('click', async () => {
    exportar.codigo.select();
    try {
      await navigator.clipboard.writeText(exportar.codigo.value);
      avisar(exportar, 'Código copiado. Cola-o num email, no Teams ou num documento.');
    } catch {
      avisar(exportar, 'Não consegui copiar sozinho. O código está selecionado: copia-o com Ctrl+C.');
    }
  });

  importar.addEventListener('submit', (e) => {
    e.preventDefault();
    let ids: string[];
    try {
      ids = descodificar(importar.codigo.value);
    } catch (erro) {
      return avisar(importar, (erro as Error).message, true);
    }
    const novos = ids.filter((id) => conhecidos.has(id) && !resolvido(id));
    const ignorados = ids.filter((id) => !conhecidos.has(id)).length;
    try {
      for (const id of novos) if (ID.test(id)) localStorage.setItem(`maismat:${id}`, 'ok');
    } catch {
      return avisar(importar, 'Este browser não deixa guardar o progresso.', true);
    }
    marcar();
    filtrar();
    const partes = [
      novos.length
        ? `Juntámos ${plural(novos.length, 'desafio', 'desafios')} ao teu progresso.`
        : 'Já tinhas todos os desafios deste código.',
      `Agora tens ${resolvidos.size} resolvidos.`,
    ];
    if (ignorados) partes.push(`${plural(ignorados, 'desafio do código não existe', 'desafios do código não existem')} neste site e ${ignorados === 1 ? 'foi ignorado' : 'foram ignorados'}.`);
    avisar(importar, partes.join(' '));
  });

  transferir.hidden = false;
</script>

<style>
  h1 { font-size: 2.5rem; margin-top: 2.5rem; margin-bottom: 0.5rem; }
  .intro { color: var(--texto-suave); font-size: 0.95rem; max-width: 40rem; }

  .filtros { display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem 1.25rem; margin: 1.5rem 0 0.5rem; font-size: 0.9rem; }
  .filtros label { display: grid; gap: 0.25rem; }
  .filtros span { color: var(--texto-suave); }
  select {
    font: inherit;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--campo);
    border-radius: 6px;
    background: var(--superficie);
    color: var(--texto);
    max-width: 100%;
  }
  .contagem { margin: 0; color: var(--texto-suave); flex-basis: 100%; }

  h2 { font-size: 1.4rem; border-bottom: 3px solid var(--dourado); padding-bottom: 0.3rem; margin-top: 2.5rem; }
  h2 .ui { font-size: 0.9rem; font-weight: 400; color: var(--texto-suave); }
  .cap { text-transform: capitalize; }

  ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1rem; }
  .desafio {
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-top: 4px solid var(--verde);
    border-radius: var(--raio);
    padding: 1rem 1.25rem;
    min-width: 0;
  }
  .desafio[data-resolvido] { border-top-color: var(--ok); }
  .rotulo { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--verde); margin: 0; }
  h3 { font-size: 1.2rem; margin: 0.25rem 0 0; overflow-wrap: anywhere; }
  h3 a { color: var(--texto); text-decoration: none; }
  h3 a:hover { color: var(--destaque); text-decoration: underline; }
  .excerto { font-size: 0.95rem; color: var(--texto-suave); margin: 0.5rem 0 0; overflow-wrap: anywhere; }
  .etiquetas { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0 0; font-size: 0.75rem; }
  .etiquetas span { padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid var(--linha); color: var(--texto-suave); }
  .etiquetas .resolvido { border-color: var(--ok); color: var(--ok); font-weight: 600; }
  [hidden] { display: none !important; }

  .transferir {
    margin: 1rem 0 0.5rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    background: var(--superficie);
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    max-width: 48rem;
  }
  .transferir summary { cursor: pointer; font-weight: 600; color: var(--destaque); }
  .transferir > p { color: var(--texto-suave); margin: 0.75rem 0 0; }
  .passos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem 1.5rem; margin-top: 1rem; }
  .passos form { display: flex; flex-wrap: wrap; align-items: start; align-content: start; gap: 0.6rem; min-width: 0; }
  .passo { font-weight: 600; margin: 0; width: 100%; }
  .passos label { display: grid; gap: 0.25rem; width: 100%; }
  .passos label span { color: var(--texto-suave); }
  textarea {
    font: 0.85rem/1.4 ui-monospace, monospace;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--campo);
    border-radius: 6px;
    background: var(--fundo);
    color: var(--texto);
    width: 100%;
    resize: vertical;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .passos button {
    font: inherit;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border: 0;
    border-radius: 6px;
    background: var(--azul);
    color: #fff;
    cursor: pointer;
  }
  .passos button:hover { background: var(--azul-escuro); }
  .mensagem { margin: 0; width: 100%; min-height: 1.4em; color: var(--ok); font-weight: 600; }
  .mensagem.erro { color: var(--erro); }
  .mensagem:empty { min-height: 0; }
</style>
