---
import Base from '../layouts/Base.astro';
import ProgressRing from '../components/ProgressRing.astro';
import { getPublishedChallenges } from '../lib/challenges';
import { monthYear, issueLabel } from '../lib/issues';

const challenges = await getPublishedChallenges();
const challengesByIssue = [...Map.groupBy(challenges, (challenge) => challenge.issue)];
---

<Base
  title="Arquivo de desafios"
  description="Todos os desafios publicados no +MAT, para voltares a encontrá-los e resolvê-los."
>
  <div class="container">
    <div class="page-header">
      <h1>
        Arquivo de <span class="highlight">desafios</span>
      </h1>
      <p>
        Os {challenges.length} desafios publicados no +MAT, da edição mais recente para a mais antiga. Cada um leva-te
        ao artigo onde podes responder e, quando existe, ver a resolução.
      </p>
    </div>

    <div class="card progress no-print">
      <ProgressRing ids={challenges.map((challenge) => challenge.id)} />
      <span class="ui on-this-device">neste aparelho</span>
    </div>

    <form class="ui filters no-print" hidden>
      <div class="pills" role="group" aria-label="Estado">
        <button type="button" data-status="unsolved" aria-pressed="false">
          Por resolver · <span class="count"></span>
        </button>
        <button type="button" data-status="solved" aria-pressed="false">
          Resolvidos · <span class="count"></span>
        </button>
        <button type="button" data-status="" aria-pressed="true">
          Todos · <span class="count"></span>
        </button>
      </div>
      <label>
        <span>Edição</span>
        <select name="issue" class="field">
          <option value="">Todas</option>
          {challengesByIssue.map(([issue]) => (
            <option value={issue.id}>{issueLabel(issue)}</option>
          ))}
        </select>
      </label>
      <p class="summary" role="status" aria-live="polite"></p>
    </form>

    <details id="levar" class="ui transfer no-print" hidden>
      <summary>Levar o teu progresso para outro computador</summary>
      <p>
        Os computadores da escola apagam muitas vezes o que fica guardado. Cria um código, envia-o a ti próprio (por
        email, no Teams ou num documento) e cola-o no outro computador. O código só diz que desafios resolveste: não tem
        o teu nome nem as tuas respostas.
      </p>
      <div class="steps">
        <form class="export">
          <p class="step">Neste computador</p>
          <button type="submit">Criar o meu código</button>
          <label hidden>
            <span>O teu código</span>
            <textarea name="code" rows="3" readonly spellcheck="false"></textarea>
          </label>
          <button type="button" class="copy" hidden>
            Copiar
          </button>
          <p class="message" role="status" aria-live="polite"></p>
          <div class="qr" hidden>
            <p class="step">Para o telemóvel</p>
            <div class="qr-image"></div>
            <p>Lê com a câmara do telemóvel.</p>
            <p class="qr-link">
              Ou abre esta ligação: <a href=""></a>
            </p>
          </div>
        </form>
        <form class="import">
          <p class="step">No outro computador</p>
          <label>
            <span>Cola aqui o teu código</span>
            <textarea name="code" rows="3" spellcheck="false" autocomplete="off"></textarea>
          </label>
          <button type="submit">Juntar ao meu progresso</button>
          <p class="message" role="status" aria-live="polite"></p>
          <div class="confirm" hidden>
            <p class="question" tabindex="-1"></p>
            <button type="button" class="confirm-yes">
              Juntar
            </button>
            <button type="button" class="confirm-no">
              Agora não
            </button>
          </div>
        </form>
      </div>
    </details>

    {challengesByIssue.map(([issue, issueChallenges]) => (
      <section class="issue" data-issue={issue.id} aria-labelledby={`issue-${issue.id}`}>
        <h2 id={`issue-${issue.id}`}>
          <span class="capitalize">{monthYear(issue.data.date)}</span> <span class="ui">· {issueLabel(issue)}</span>
        </h2>
        <ul>
          {issueChallenges.map((challenge) => (
            <li class="challenge" data-id={challenge.id}>
              <p class="ui eyebrow">
                <span>
                  Desafio{challenge.number && ` ${challenge.number}`} · {challenge.article.data.title}
                </span>
                <span class="solved-badge" hidden>
                  <span aria-hidden="true">✓</span> Resolvido
                </span>
              </p>
              <h3>
                <a href={challenge.url}>{challenge.title}</a>
              </h3>
              {challenge.excerpt.length > 0 && (
                <p class="excerpt">
                  {challenge.excerpt.map((segment) =>
                    'html' in segment ? <Fragment set:html={segment.html} /> : segment.text,
                  )}
                </p>
              )}
              {(challenge.hasAnswer || challenge.hasSolution) && (
                <p class="ui tags">
                  {challenge.hasAnswer && <span>Com verificação</span>}
                  {challenge.hasSolution && <span>Com resolução</span>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<script>
  import { encode } from 'uqr';
  import { CHALLENGE_ID, codeFromLink, decodeProgress, encodeProgress, progressLink } from '../lib/progress-code';
  import { PROGRESS_EVENT, challengeIdFromKey, isSolved, markSolved, SOLVED } from '../lib/storage';

  type StatusFilter = '' | 'solved' | 'unsolved';

  const filterForm = document.querySelector<HTMLFormElement>('.filters')!;
  const summary = filterForm.querySelector<HTMLElement>('.summary')!;
  const issueSelect = filterForm.querySelector<HTMLSelectElement>('select')!;
  const issueSections = [...document.querySelectorAll<HTMLElement>('.issue')];
  const items = [...document.querySelectorAll<HTMLElement>('.challenge')];

  // By id: a republished challenge (for example, in the solutions) counts only once.
  const solvedIds = new Set<string>();
  function markSolvedItems() {
    for (const item of items) {
      if (!isSolved(item.dataset.id!)) continue;
      item.dataset.solved = '';
      item.querySelector<HTMLElement>('.solved-badge')!.hidden = false;
      solvedIds.add(item.dataset.id!);
    }
  }
  markSolvedItems();

  const statusButtons = [...filterForm.querySelectorAll<HTMLButtonElement>('[data-status]')];
  let statusFilter: StatusFilter = '';
  for (const button of statusButtons)
    button.addEventListener('click', () => {
      statusFilter = button.dataset.status as StatusFilter;
      for (const other of statusButtons) other.setAttribute('aria-pressed', String(other === button));
      applyFilters();
    });

  function applyFilters() {
    const issueId = issueSelect.value;
    const counts: Record<StatusFilter, number> = { '': items.length, solved: 0, unsolved: 0 };
    for (const item of items) counts['solved' in item.dataset ? 'solved' : 'unsolved']++;
    for (const button of statusButtons)
      button.querySelector('.count')!.textContent = String(counts[button.dataset.status as StatusFilter]);
    let visibleCount = 0;
    for (const section of issueSections) {
      let anyVisible = false;
      for (const item of section.querySelectorAll<HTMLElement>('.challenge')) {
        const solved = 'solved' in item.dataset;
        item.hidden = (statusFilter === 'solved' && !solved) || (statusFilter === 'unsolved' && solved);
        if (!item.hidden) anyVisible = true;
        if (!item.hidden && (!issueId || section.dataset.issue === issueId)) visibleCount++;
      }
      section.hidden = !anyVisible || (issueId !== '' && section.dataset.issue !== issueId);
    }
    summary.textContent = `A mostrar ${visibleCount} de ${items.length} desafios · resolveste ${solvedIds.size}.`;
  }

  filterForm.addEventListener('change', applyFilters);
  filterForm.addEventListener('submit', (event) => event.preventDefault());
  // The summary is filled in before the form shows up, so it is not announced when the page opens.
  applyFilters();
  filterForm.hidden = false;

  const transfer = document.querySelector<HTMLDetailsElement>('.transfer')!;
  const exportForm = transfer.querySelector<HTMLFormElement>('.export')!;
  const importForm = transfer.querySelector<HTMLFormElement>('.import')!;
  const exportCode = exportForm.querySelector<HTMLTextAreaElement>('textarea')!;
  const importCode = importForm.querySelector<HTMLTextAreaElement>('textarea')!;
  const copyButton = exportForm.querySelector<HTMLButtonElement>('.copy')!;
  const qr = exportForm.querySelector<HTMLElement>('.qr')!;
  const confirmBox = importForm.querySelector<HTMLElement>('.confirm')!;
  const knownIds = new Set(items.map((item) => item.dataset.id!));
  const plural = (n: number, one: string, many: string) => (n === 1 ? `1 ${one}` : `${n} ${many}`);

  function showMessage(form: HTMLFormElement, text: string, isError = false) {
    const message = form.querySelector<HTMLElement>('.message')!;
    message.textContent = text;
    message.classList.toggle('error', isError);
  }

  function solvedIdsInStorage(): string[] {
    const ids: string[] = [];
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i) ?? '';
      const id = challengeIdFromKey(key);
      if (id && CHALLENGE_ID.test(id) && localStorage.getItem(key) === SOLVED) ids.push(id);
    }
    return ids;
  }

  exportForm.addEventListener('submit', (event) => {
    event.preventDefault();
    let ids: string[];
    try {
      ids = solvedIdsInStorage();
    } catch {
      return showMessage(exportForm, 'Este browser não deixa ler o progresso guardado.', true);
    }
    if (!ids.length) return showMessage(exportForm, 'Ainda não resolveste nenhum desafio neste computador.', true);
    exportCode.value = encodeProgress(ids);
    exportCode.closest('label')!.hidden = false;
    copyButton.hidden = false;
    drawQrCode(progressLink(location.origin, ids));
    exportCode.select();
    showMessage(
      exportForm,
      `Código criado com ${plural(ids.length, 'desafio resolvido', 'desafios resolvidos')}. Copia-o e guarda-o.`,
    );
  });

  copyButton.addEventListener('click', async () => {
    exportCode.select();
    try {
      await navigator.clipboard.writeText(exportCode.value);
      showMessage(exportForm, 'Código copiado. Cola-o num email, no Teams ou num documento.');
    } catch {
      showMessage(exportForm, 'Não consegui copiar sozinho. O código está selecionado: copia-o com Ctrl+C.');
    }
  });

  // One path per row of black modules; the white background (with a 4-module quiet zone) stays white in dark mode too.
  function drawQrCode(url: string) {
    const { data, size } = encode(url, { ecc: 'L', border: 4 });
    let path = '';
    data.forEach((row, y) => {
      for (let x = 0; x < size; x++) {
        if (!row[x]) continue;
        const start = x;
        while (row[x + 1]) x++;
        path += `M${start} ${y}h${x - start + 1}v1H${start}z`;
      }
    });
    qr.querySelector('.qr-image')!.innerHTML =
      `<svg role="img" aria-label="Código QR com a ligação para levar o teu progresso para o telemóvel" viewBox="0 0 ${size} ${size}" shape-rendering="crispEdges">` +
      `<rect width="${size}" height="${size}" fill="#fff"/><path d="${path}" fill="#000"/></svg>`;
    const link = qr.querySelector<HTMLAnchorElement>('.qr-link a')!;
    link.href = url;
    link.textContent = url;
    qr.hidden = false;
  }

  const newIdsIn = (ids: string[]) => ids.filter((id) => knownIds.has(id) && !isSolved(id));

  function mergeProgress(ids: string[]) {
    confirmBox.hidden = true;
    const newIds = newIdsIn(ids);
    const unknownCount = ids.filter((id) => !knownIds.has(id)).length;
    if (!newIds.filter((id) => CHALLENGE_ID.test(id)).every(markSolved))
      return showMessage(importForm, 'Este browser não deixa guardar o progresso.', true);
    markSolvedItems();
    applyFilters();
    document.dispatchEvent(new Event(PROGRESS_EVENT));
    const parts = [
      newIds.length
        ? `Juntámos ${plural(newIds.length, 'desafio', 'desafios')} ao teu progresso.`
        : 'Já tinhas todos os desafios deste código.',
      `Agora tens ${plural(solvedIds.size, 'resolvido', 'resolvidos')}.`,
    ];
    if (unknownCount)
      parts.push(
        `${plural(unknownCount, 'desafio do código não existe', 'desafios do código não existem')} neste site e ${unknownCount === 1 ? 'foi ignorado' : 'foram ignorados'}.`,
      );
    showMessage(importForm, parts.join(' '));
  }

  importForm.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      mergeProgress(decodeProgress(importCode.value));
    } catch (error) {
      confirmBox.hidden = true;
      showMessage(importForm, (error as Error).message, true);
    }
  });

  transfer.hidden = false;

  // QR code link (/desafios/#progresso=MAT1-…): fills in the field and asks before writing anything.
  // Also when the page is already open, because then the browser only changes the fragment.
  const question = confirmBox.querySelector<HTMLElement>('.question')!;
  let idsToConfirm: string[] = [];
  confirmBox.querySelector('.confirm-yes')!.addEventListener('click', () => mergeProgress(idsToConfirm));
  confirmBox.querySelector('.confirm-no')!.addEventListener('click', () => {
    confirmBox.hidden = true;
    showMessage(importForm, 'Não juntámos nada. O código ficou no campo, se mudares de ideias.');
  });

  function handleFragment() {
    // From the "More" sheet: open the transfer panel.
    if (location.hash === '#levar') {
      transfer.open = true;
      return transfer.scrollIntoView({ block: 'start' });
    }
    const code = codeFromLink(location.hash);
    if (code === null) return;
    history.replaceState(null, '', location.pathname + location.search);
    transfer.open = true;
    importCode.value = code;
    confirmBox.hidden = true;
    showMessage(importForm, '');
    transfer.scrollIntoView({ block: 'start' });
    let ids: string[];
    try {
      ids = decodeProgress(code);
    } catch (error) {
      return showMessage(importForm, (error as Error).message, true);
    }
    const newCount = newIdsIn(ids).length;
    if (!newCount) return mergeProgress(ids);
    idsToConfirm = ids;
    question.textContent = `Juntar ${plural(newCount, 'desafio', 'desafios')} ao teu progresso?`;
    confirmBox.hidden = false;
    question.focus();
  }
  handleFragment();
  addEventListener('hashchange', handleFragment);
</script>

<style>
  .progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    max-width: 30rem;
  }
  .on-this-device {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem 1.25rem;
    margin: 1.5rem 0 0.5rem;
    font-size: 0.9375rem;
  }
  .filters label {
    display: grid;
    gap: 0.25rem;
  }
  .filters label > span {
    font-weight: 600;
  }
  .summary {
    margin: 0;
    color: var(--text-muted);
    flex-basis: 100%;
  }

  h2 {
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  h2 .ui {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-muted);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .challenge {
    padding: 1rem 1.25rem;
    min-width: 0;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .challenge[data-solved] {
    box-shadow: 0 0 0 2px var(--ok);
  }
  .eyebrow {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0;
  }
  .eyebrow .solved-badge {
    color: var(--ok);
    white-space: nowrap;
  }
  h3 {
    margin: 0.375rem 0 0;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .excerpt {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0.5rem 0 0;
    overflow-wrap: anywhere;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .tags span {
    padding: 0.2rem 0.625rem;
    border-radius: var(--radius-lg);
    background: var(--pill);
    color: var(--text-muted);
  }
  [hidden] {
    display: none !important;
  }

  .transfer {
    margin: 1rem 0 0.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    max-width: 48rem;
  }
  .transfer summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-weight: 600;
    color: var(--primary);
  }
  .transfer > p {
    color: var(--text-muted);
    margin: 0.75rem 0 0;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem 1.5rem;
    margin-top: 1rem;
  }
  .steps form {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    align-content: start;
    gap: 0.6rem;
    min-width: 0;
  }
  .step {
    font-weight: 600;
    margin: 0;
    width: 100%;
  }
  .steps label {
    display: grid;
    gap: 0.25rem;
    width: 100%;
  }
  .steps label span {
    color: var(--text-muted);
  }
  textarea {
    font:
      0.85rem/1.4 ui-monospace,
      monospace;
    padding: 0.45rem 0.6rem;
    border: 2px solid var(--field-border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    width: 100%;
    resize: vertical;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .steps button {
    min-height: 44px;
    padding: 0 1.125rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--on-primary);
    font: 700 0.875rem var(--font-ui);
    cursor: pointer;
  }
  .steps button:hover {
    background: var(--primary-strong);
  }
  .steps button:focus-visible {
    outline-color: var(--text);
  }
  .message {
    margin: 0;
    width: 100%;
    min-height: 1.4em;
    color: var(--ok);
    font-weight: 600;
  }
  .message.error {
    color: var(--error);
  }
  .message:empty {
    min-height: 0;
  }

  .qr,
  .confirm {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    width: 100%;
  }
  .qr p,
  .confirm p {
    margin: 0;
    width: 100%;
  }
  .qr-image {
    width: 100%;
    max-width: 16rem;
  }
  .qr-image :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    outline: 1px solid var(--border);
  }
  .qr-link {
    color: var(--text-muted);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .question {
    font-weight: 600;
  }
  .steps .confirm-no {
    background: none;
    color: var(--text);
    box-shadow: inset 0 0 0 2px var(--field-border);
  }
  .steps .confirm-no:hover {
    background: var(--bg);
  }
</style>
