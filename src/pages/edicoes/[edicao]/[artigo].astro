---
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {
  getIssueArticles,
  getPublishedArticles,
  monthYear,
  issueLabel,
  articleSlug,
  type Article,
} from '../../../lib/issues';
import { mdxComponents } from '../../../lib/mdx-components';
import { SECTIONS } from '../../../lib/sections';
import { isoDay, publisher, publicationIssue, persons } from '../../../lib/structured-data';
import { lastUpdated } from '../../../lib/git';

export async function getStaticPaths() {
  const artigos = await getPublishedArticles();
  return artigos.map((artigo) => ({
    params: { edicao: artigo.data.edicao.id, artigo: articleSlug(artigo) },
    props: { artigo },
  }));
}

const { artigo } = Astro.props as { artigo: Article };
const edicao = (await getEntry(artigo.data.edicao))!;
const { Content } = await render(artigo);
const irmaos = await getIssueArticles(edicao.id);
const i = irmaos.findIndex((a) => a.id === artigo.id);
const [anterior, seguinte] = [irmaos[i - 1], irmaos[i + 1]];
const { titulo, seccao, autores, nivel, citacao, resumo } = artigo.data;
const url = (a: Article) => `/edicoes/${edicao.id}/${articleSlug(a)}/`;
const minutos = Math.max(1, Math.round((artigo.body ?? '').split(/\s+/).filter(Boolean).length / 200));
// O marcador dourado vai na última palavra do título, se for comprida o bastante para se ver.
const partes = titulo.match(/^(.*\s)(\p{L}{5,})([^\p{L}]*)$/u);
const autoria = persons(autores);
const dados = {
  '@type': 'Article',
  headline: titulo,
  description: resumo,
  author: autoria.length ? autoria : undefined,
  datePublished: isoDay(edicao.data.data),
  dateModified: artigo.filePath && lastUpdated(artigo.filePath),
  inLanguage: 'pt-PT',
  isPartOf: publicationIssue(edicao, Astro.site!),
  publisher: publisher(Astro.site!),
};
---

<Base titulo={titulo} descricao={resumo} edicao={edicao} artigo dados={dados}>
  <article
    class="contentor"
    data-pagefind-body
    data-pagefind-meta={`edicao:${issueLabel(edicao)} · ${monthYear(edicao.data.data)}`}
    data-pagefind-filter={`edicao:${issueLabel(edicao)}`}
    data-pagefind-sort={`data:${edicao.data.data.toISOString().slice(0, 10)}`}
  >
    <header>
      <a
        class="etiqueta"
        href={`/seccoes/${seccao}/`}
        data-pagefind-filter={`seccao:${SECTIONS[seccao]}`}
        data-pagefind-ignore
      >
        {SECTIONS[seccao]}
      </a>
      <h1>
        {partes ? (
          <>
            {partes[1]}
            <span class="marcador">{partes[2]}</span>
            {partes[3]}
          </>
        ) : (
          titulo
        )}
      </h1>
      <p class="ui meta" data-pagefind-ignore>
        <a href={`/edicoes/${edicao.id}/`}>
          {issueLabel(edicao)} · <span class="cap">{monthYear(edicao.data.data)}</span>
        </a>
        <span>
          {i + 1} de {irmaos.length}
        </span>
        <span>{minutos} min de leitura</span>
      </p>
      {(autores || nivel) && (
        <p class="ui autoria">
          {autores && <span>{autores.join(', ')}</span>}
          {nivel && <span class="nivel">{nivel}</span>}
        </p>
      )}
      {citacao && (
        <blockquote class="citacao">
          “{citacao.texto}”<footer>— {citacao.autor}</footer>
        </blockquote>
      )}
    </header>

    <div class="prosa">
      <Content components={mdxComponents} />
    </div>

    <nav class="ui navegacao nao-imprimir" aria-label="Artigos desta edição" data-pagefind-ignore>
      {anterior ? (
        <a class="cartao" href={url(anterior)}>
          <small>← Anterior</small>
          {anterior.data.titulo}
        </a>
      ) : (
        <span></span>
      )}
      {seguinte && (
        <a class="cartao seg" href={url(seguinte)}>
          <small>Seguinte →</small>
          {seguinte.data.titulo}
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  article {
    max-width: calc(var(--leitura) + 2rem);
  }
  header {
    padding-top: 2rem;
    margin-bottom: 2rem;
  }
  h1 {
    margin: 0.75rem 0 0.75rem;
  }
  .meta,
  .autoria {
    display: flex;
    gap: 0.25rem 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    color: var(--texto-suave);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }
  .meta > * + *::before {
    content: '·';
    margin-right: 0.75rem;
  }
  .meta a {
    color: inherit;
    text-decoration: none;
  }
  .meta a:hover {
    text-decoration: underline;
  }
  .autoria {
    margin-top: 0.5rem;
    color: var(--texto);
  }
  .nivel {
    background: var(--pastilha);
    color: var(--texto);
    font-weight: 600;
    font-size: 0.75rem;
    padding: 0.15rem 0.625rem;
    border-radius: var(--raio-g);
  }
  .citacao {
    font-style: italic;
    font-size: 1.125rem;
    margin: 1.5rem 0 0;
    padding-left: 1rem;
    border-left: 4px solid var(--marcador);
  }
  .citacao footer {
    font-family: var(--f-ui);
    font-style: normal;
    font-size: 0.875rem;
    color: var(--texto-suave);
    margin-top: 0.3rem;
  }
  .navegacao {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 3.5rem;
  }
  .navegacao a {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .navegacao small {
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  .seg {
    text-align: right;
  }
</style>
