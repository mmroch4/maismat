---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { artigosDe, edicoesPublicadas, mesAno, rotuloEdicao, type Edicao } from '../../../lib/edicoes';
import { componentesMdx } from '../../../lib/componentes-mdx';
import { SECCOES } from '../../../lib/seccoes';

export async function getStaticPaths() {
  const edicoes = (await edicoesPublicadas()).filter((e) => e.data.convertida);
  return edicoes.map((edicao) => ({ params: { edicao: edicao.id }, props: { edicao } }));
}

const { edicao } = Astro.props as { edicao: Edicao };
const artigos = await Promise.all(
  (await artigosDe(edicao.id)).map(async (a) => ({ a, Content: (await render(a)).Content })),
);
---

<Base titulo={`${rotuloEdicao(edicao)} — versão para imprimir`} edicao={edicao}>
  <div class="contentor impressao">
    <p class="ui nao-imprimir dica">
      Usa <kbd>Ctrl</kbd>+<kbd>P</kbd> (ou <kbd>⌘</kbd>+<kbd>P</kbd>) e escolhe “Guardar como PDF”.
      <button type="button" class="botao" onclick="window.print()">
        Imprimir agora
      </button>
    </p>
    <header class="folha-rosto">
      <p class="ui">Agrupamento de Escolas Domingos Sequeira</p>
      <h1>+MAT</h1>
      <p class="sub">
        Jornal de Matemática · {rotuloEdicao(edicao)} · <span class="cap">{mesAno(edicao.data.data)}</span>
      </p>
      <p class="ui">Direção e edição: {edicao.data.direcao.join(' e ')}</p>
      <ol class="ui">
        {artigos.map(({ a }) => (
          <li>
            {SECCOES[a.data.seccao]} — {a.data.titulo}
          </li>
        ))}
      </ol>
    </header>
    {artigos.map(({ a, Content }) => (
      <section class="artigo">
        <span class="etiqueta">+ {SECCOES[a.data.seccao]}</span>
        <h2>{a.data.titulo}</h2>
        {a.data.autores && <p class="ui autores">{a.data.autores.join(', ')}</p>}
        <div class="prosa">
          <Content components={componentesMdx} />
        </div>
      </section>
    ))}
    <p class="ui creditos">+MAT · {Astro.site!.host} · Versão digital: Miguel Rocha</p>
  </div>
</Base>

<style>
  .impressao {
    max-width: calc(var(--leitura) + 2rem);
  }
  .dica {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    background: var(--pastilha);
    padding: 0.75rem 1rem;
    border-radius: var(--raio);
    font-size: 0.9375rem;
    margin-top: 2rem;
  }
  .folha-rosto {
    text-align: center;
    padding: 3rem 0;
    border-bottom: 3px solid var(--etiqueta);
  }
  .folha-rosto h1 {
    font-size: 5rem;
    margin: 0.5rem 0;
  }
  .folha-rosto ol {
    text-align: left;
    display: inline-block;
    font-size: 0.9rem;
  }
  .sub {
    font-family: var(--f-titulo);
    font-size: 1.3rem;
  }
  .cap {
    text-transform: capitalize;
  }
  .artigo {
    padding-top: 2.5rem;
  }
  .artigo h2 {
    font-size: 2rem;
    margin: 0.5rem 0;
  }
  .autores {
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .creditos {
    text-align: center;
    color: var(--texto-suave);
    font-size: 0.8rem;
    margin-top: 4rem;
  }
  @media print {
    .folha-rosto {
      break-after: page;
    }
    .artigo {
      break-before: page;
      padding-top: 0;
    }
    .artigo :global(figure),
    .artigo :global(img),
    .artigo :global(.desafio) {
      break-inside: avoid;
    }
  }
</style>
