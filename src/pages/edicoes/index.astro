---
import Base from '../../layouts/Base.astro';
import IssueCard from '../../components/IssueCard.astro';
import { getSortedIssues, monthYear } from '../../lib/issues';

const issues = await getSortedIssues();
const issuesByYear = Map.groupBy(issues, (issue) => issue.data.year);
// The school year runs from September to August: May 2025 is 2024/25.
const schoolYear = (date: Date) => {
  const start = date.getUTCFullYear() - (date.getUTCMonth() < 8 ? 1 : 0);
  return `${start}/${String(start + 1).slice(2)}`;
};
const firstIssue = issues.at(-1);
---

<Base title="Edições" description="Todas as edições do +MAT, Jornal de Matemática.">
  <div class="container">
    <div class="page-header">
      <h1>
        <span class="highlight">Edições</span>
      </h1>
      <p>
        {issues.length} edições{firstIssue && ` desde ${monthYear(firstIssue.data.date)}`}, três por ano letivo. As
        marcadas com <em>PDF</em> ainda estão a ser convertidas para a versão digital.
      </p>
    </div>
    {[...issuesByYear].map(([year, yearIssues]) => (
      <section aria-labelledby={`ano-${year}`}>
        <h2 id={`ano-${year}`}>
          Ano {year} <span class="ui">{schoolYear(yearIssues[0].data.date)}</span>
        </h2>
        <div class="issue-grid">
          {yearIssues.map((issue) => (
            <IssueCard issue={issue} />
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  h2 .ui {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-muted);
  }
  .issue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.5rem;
  }
</style>
