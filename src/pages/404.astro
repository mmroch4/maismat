---
// O Cloudflare Pages serve dist/404.html a qualquer endereço que não exista.
import Base from '../layouts/Base.astro';
import FormPesquisa from '../components/FormPesquisa.astro';
import PaginasDoJornal from '../components/PaginasDoJornal.astro';
---

<Base titulo="Página não encontrada" descricao="Esta página não existe no +MAT.">
  <div class="contentor">
    <p class="ui rotulo">Erro 404</p>
    <h1>Esta conta não bate certo</h1>
    <p class="texto">
      Procurámos em todas as edições e não encontrámos esta página. Pode ter mudado de sítio, ou o endereço pode ter um
      engano.
    </p>
    <FormPesquisa />
    <p class="ui aviso">Ou procura nestas páginas:</p>
    <PaginasDoJornal />
  </div>
</Base>

<style>
  .rotulo { font-size: 0.85rem; color: var(--texto-suave); letter-spacing: 0.04em; margin: 2.5rem 0 0; }
  h1 { font-size: 2.5rem; margin: 0.2rem 0 1rem; }
  .texto { max-width: var(--leitura); margin-bottom: 1.5rem; }
  .aviso { color: var(--texto-suave); font-size: 0.95rem; margin-top: 2rem; }
</style>
