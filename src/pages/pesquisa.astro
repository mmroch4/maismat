---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import SiteIndex from '../components/SiteIndex.astro';
import { getSortedIssues, issueLabel } from '../lib/issues';
import { SECTIONS } from '../lib/sections';

// The URL carries the ids (?edicao=ano3-edicao2&seccao=geometria, public URLs that stay in Portuguese);
// Pagefind filters by the text shown on the pages.
const issueOptions = (await getSortedIssues()).map((issue) => ({ id: issue.id, label: issueLabel(issue) }));
const sectionOptions = Object.entries(SECTIONS).map(([id, label]) => ({ id, label }));
---

<Base title="Pesquisar" description="Pesquisa nos artigos e nas edições do +MAT.">
  <div class="container">
    <div class="page-header">
      <h1>
        <span class="highlight">Pesquisar</span> no +MAT
      </h1>
    </div>

    <SearchForm hidden>
      <div class="filters">
        <fieldset>
          <legend>Secção</legend>
          <div class="checkboxes">
            {sectionOptions.map((option) => (
              <label>
                <input type="checkbox" name="seccao" value={option.id} data-label={option.label} /> {option.label}{' '}
                <span class="count"></span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="filter">
          <label for="issue-filter">Edição</label>
          <select id="issue-filter" name="edicao" class="field">
            <option value="">Todas</option>
            {issueOptions.map((option) => (
              <option value={option.id} data-label={option.label}>
                {option.label}
              </option>
            ))}
          </select>
        </div>
      </div>
    </SearchForm>
    <p class="ui status" role="status" aria-live="polite"></p>
    <ol class="results"></ol>
    <button type="button" class="button secondary show-more" hidden>
      Mostrar mais resultados
    </button>

    <section class="ui fallback" aria-labelledby="fallback-heading">
      <p id="fallback-heading" class="hint">
        A pesquisa precisa de JavaScript. Podes procurar nestas páginas:
      </p>
      <SiteIndex />
    </section>
  </div>
</Base>

<script>
  type SearchResult = { url: string; excerpt: string; meta: { title?: string; issue?: string } };
  type PendingResult = { data(): Promise<SearchResult> };
  type Filters = Record<string, string | { any: string[] }>;
  type Pagefind = {
    options(options: object): Promise<void>;
    filters(): Promise<Record<string, Record<string, number>>>;
    search(
      query: string | null,
      options?: { filters: Filters; sort?: Record<string, 'asc' | 'desc'> },
    ): Promise<{ results: PendingResult[] } | null>;
  };

  const PAGE_SIZE = 10;
  const SEARCH_DELAY_MS = 300;
  const form = document.querySelector<HTMLFormElement>('.search-form')!;
  const queryInput = form.querySelector<HTMLInputElement>('input')!;
  const issueSelect = form.querySelector<HTMLSelectElement>('select')!;
  const sectionCheckboxes = [...form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
  const status = document.querySelector<HTMLElement>('.status')!;
  const resultList = document.querySelector<HTMLOListElement>('.results')!;
  const showMore = document.querySelector<HTMLButtonElement>('.show-more')!;
  const fallback = document.querySelector<HTMLElement>('.fallback')!;

  let pagefind: Pagefind;
  let pending: PendingResult[] = [];
  let latestSearch = 0;

  async function showResults(count: number) {
    const batch = pending.splice(0, count);
    for (const result of await Promise.all(batch.map((r) => r.data()))) {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = result.url;
      link.textContent = result.meta.title ?? result.url;
      item.append(link);
      if (result.meta.issue) {
        const meta = document.createElement('p');
        meta.className = 'ui meta';
        meta.textContent = result.meta.issue;
        item.append(meta);
      }
      const excerpt = document.createElement('p');
      excerpt.className = 'excerpt';
      // Pagefind returns the excerpt already escaped, with only <mark> around the matched words.
      excerpt.innerHTML = result.excerpt;
      item.append(excerpt);
      resultList.append(item);
    }
    showMore.hidden = pending.length === 0;
  }

  async function search() {
    const searchId = ++latestSearch;
    const query = queryInput.value.trim();
    const checked = sectionCheckboxes.filter((checkbox) => checkbox.checked);
    const params = new URLSearchParams();
    if (query) params.set('q', query);
    if (issueSelect.value) params.set('edicao', issueSelect.value);
    for (const checkbox of checked) params.append('seccao', checkbox.value);
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    if (!query && !issueSelect.value && !checked.length) {
      resultList.replaceChildren();
      showMore.hidden = true;
      status.textContent = '';
      return;
    }
    const selectedIssue = issueSelect.value && issueSelect.selectedOptions[0].dataset.label!;
    // Pagefind accepts several sections at once: any of them is enough.
    const filters: Filters = {};
    if (selectedIssue) filters.issue = selectedIssue;
    if (checked.length) filters.section = { any: checked.map((checkbox) => checkbox.dataset.label!) };
    // Without a query there is no relevance: newest issues first.
    const response = await pagefind.search(query || null, { filters, sort: query ? undefined : { date: 'desc' } });
    if (!response || searchId !== latestSearch) return;
    resultList.replaceChildren();
    pending = response.results;
    const total = response.results.length;
    const filterNames = [...checked.map((checkbox) => checkbox.dataset.label!), selectedIssue].filter(Boolean);
    const scope = [query && `para «${query}»`, filterNames.length && `em ${filterNames.join(', ')}`]
      .filter(Boolean)
      .join(' ');
    status.textContent =
      total === 0 ? `Não encontrei nada ${scope}.` : `${total === 1 ? '1 resultado' : `${total} resultados`} ${scope}.`;
    await showResults(PAGE_SIZE);
  }

  let debounce: number;
  queryInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = window.setTimeout(search, SEARCH_DELAY_MS);
  });
  for (const control of [issueSelect, ...sectionCheckboxes]) control.addEventListener('change', search);
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    clearTimeout(debounce);
    search();
  });
  showMore.addEventListener('click', () => showResults(PAGE_SIZE));

  try {
    // The index only exists after `npm run build` (Pagefind runs over dist).
    const url = '/pagefind/pagefind.js';
    pagefind = await import(/* @vite-ignore */ url);
    await pagefind.options({ excerptLength: 24 });
    const counts = await pagefind.filters();
    for (const option of [...issueSelect.options].filter((option) => option.value)) {
      const count = counts.issue?.[option.dataset.label!] ?? 0;
      if (count) option.textContent += ` (${count})`;
      else option.remove();
    }
    for (const checkbox of sectionCheckboxes) {
      const count = counts.section?.[checkbox.dataset.label!] ?? 0;
      if (count) checkbox.parentElement!.querySelector('.count')!.textContent = String(count);
      else checkbox.parentElement!.remove();
    }
    const params = new URLSearchParams(location.search);
    queryInput.value = params.get('q') ?? '';
    const requestedIssue = params.get('edicao');
    issueSelect.value = [...issueSelect.options].some((option) => option.value === requestedIssue)
      ? requestedIssue!
      : '';
    const requestedSections = params.getAll('seccao');
    for (const checkbox of sectionCheckboxes) checkbox.checked = requestedSections.includes(checkbox.value);
    form.hidden = false;
    // On phones the row of sections scrolls sideways: the first checked one must be visible.
    sectionCheckboxes
      .find((checkbox) => checkbox.checked)
      ?.parentElement!.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    fallback.hidden = true;
    if (queryInput.value || issueSelect.value || requestedSections.length) search();
    else queryInput.focus();
  } catch {
    fallback.querySelector('.hint')!.textContent =
      'A pesquisa não está disponível neste momento. Podes procurar nestas páginas:';
  }
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .filters {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  legend,
  .filter label {
    font-weight: 600;
    margin-bottom: 0.375rem;
    padding: 0;
  }
  .checkboxes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* On phones the sections stay on a single row that scrolls sideways */
  @media (max-width: 768px) {
    .checkboxes {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: -1rem;
      padding: 0.25rem 1rem;
      scrollbar-width: none;
    }
    .checkboxes label {
      flex-shrink: 0;
    }
  }
  .checkboxes label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.875rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 2px var(--border);
    white-space: nowrap;
    cursor: pointer;
  }
  .checkboxes label:has(:checked) {
    background: var(--pill);
    box-shadow: inset 0 0 0 2px var(--primary);
    font-weight: 600;
  }
  .checkboxes input {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--primary);
  }
  .checkboxes .count {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 400;
  }
  .filter {
    display: grid;
    max-width: 20rem;
  }

  .status {
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    margin: 1.5rem 0 0;
  }
  .status:empty {
    margin: 0;
  }

  .results {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1.5rem;
    max-width: var(--reading-width);
    display: grid;
    gap: 0.75rem;
  }
  /* Results are created in the browser and lack Astro's scoping attribute, hence :global. */
  .results :global(li) {
    padding: 1rem 1.25rem;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    min-width: 0;
  }
  .results :global(a) {
    font-family: var(--font-ui);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .results :global(a:hover) {
    text-decoration: underline;
  }
  .results :global(.meta) {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0.15rem 0 0;
    text-transform: capitalize;
  }
  .results :global(.excerpt) {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0.4rem 0 0;
    overflow-wrap: anywhere;
  }
  .results :global(mark) {
    background: linear-gradient(transparent 55%, var(--highlight) 55%);
    color: var(--text);
    padding: 0 0.05em;
  }

  .fallback {
    font-size: 0.95rem;
  }
  .hint {
    color: var(--text-muted);
  }
</style>
