---
import Base from '../layouts/Base.astro';
import FormPesquisa from '../components/FormPesquisa.astro';
import PaginasDoJornal from '../components/PaginasDoJornal.astro';
import { edicoesOrdenadas, rotuloEdicao } from '../lib/edicoes';
import { SECCOES } from '../lib/seccoes';

// No URL vão os ids (?edicao=ano3-edicao2&seccao=geometria); no Pagefind, o texto que está nas páginas.
const edicoes = (await edicoesOrdenadas()).map((e) => ({ id: e.id, valor: rotuloEdicao(e) }));
const seccoes = Object.entries(SECCOES).map(([id, nome]) => ({ id, valor: nome }));
const filtros = [
  { nome: 'edicao', rotulo: 'Edição', opcoes: edicoes },
  { nome: 'seccao', rotulo: 'Secção', opcoes: seccoes },
];
---

<Base titulo="Pesquisar" descricao="Pesquisa nos artigos e nas edições do +MAT.">
  <div class="contentor">
    <h1>Pesquisar no +MAT</h1>

    <FormPesquisa escondido>
      <div class="filtros">
        {filtros.map((f) => (
          <div class="filtro">
            <label for={f.nome}>{f.rotulo}</label>
            <select id={f.nome} name={f.nome}>
              <option value="">Todas</option>
              {f.opcoes.map((o) => <option value={o.id} data-valor={o.valor}>{o.valor}</option>)}
            </select>
          </div>
        ))}
      </div>
    </FormPesquisa>
    <p class="ui estado" role="status" aria-live="polite"></p>
    <ol class="resultados"></ol>
    <button type="button" class="ui mais" hidden>Mostrar mais resultados</button>

    <section class="ui alternativa" aria-labelledby="alt-titulo">
      <p id="alt-titulo" class="aviso">A pesquisa precisa de JavaScript. Podes procurar nestas páginas:</p>
      <PaginasDoJornal />
    </section>
  </div>
</Base>

<script>
  type Resultado = { url: string; excerpt: string; meta: { title?: string; edicao?: string } };
  type Pagefind = {
    options(o: object): Promise<void>;
    filters(): Promise<Record<string, Record<string, number>>>;
    search(q: string | null, o?: { filters: Record<string, string> }): Promise<{ results: { data(): Promise<Resultado> }[] } | null>;
  };

  const POR_PAGINA = 10;
  const form = document.querySelector<HTMLFormElement>('.pesquisa')!;
  const campo = form.querySelector<HTMLInputElement>('input')!;
  const listas = [...form.querySelectorAll('select')];
  const estado = document.querySelector<HTMLElement>('.estado')!;
  const lista = document.querySelector<HTMLOListElement>('.resultados')!;
  const mais = document.querySelector<HTMLButtonElement>('.mais')!;
  const alternativa = document.querySelector<HTMLElement>('.alternativa')!;

  let pagefind: Pagefind;
  let pendentes: { data(): Promise<Resultado> }[] = [];
  let pedido = 0;

  async function mostrar(n: number) {
    const lote = pendentes.splice(0, n);
    for (const r of await Promise.all(lote.map((r) => r.data()))) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = r.url;
      a.textContent = r.meta.title ?? r.url;
      li.append(a);
      if (r.meta.edicao) {
        const m = document.createElement('p');
        m.className = 'ui meta';
        m.textContent = r.meta.edicao;
        li.append(m);
      }
      const ex = document.createElement('p');
      ex.className = 'excerto';
      // O Pagefind devolve o excerto já escapado, só com <mark> à volta das palavras encontradas.
      ex.innerHTML = r.excerpt;
      li.append(ex);
      lista.append(li);
    }
    mais.hidden = pendentes.length === 0;
  }

  async function pesquisar() {
    const este = ++pedido;
    const termo = campo.value.trim();
    const escolhidas = listas.map((s) => s.selectedOptions[0]).filter((o) => o.value);
    const parametros = new URLSearchParams();
    if (termo) parametros.set('q', termo);
    for (const s of listas) if (s.value) parametros.set(s.name, s.value);
    history.replaceState(null, '', parametros.size ? `?${parametros}` : location.pathname);
    if (!termo && !escolhidas.length) {
      lista.replaceChildren();
      mais.hidden = true;
      estado.textContent = '';
      return;
    }
    const filtros = Object.fromEntries(listas.filter((s) => s.value).map((s) => [s.name, s.selectedOptions[0].dataset.valor!]));
    const r = await pagefind.search(termo || null, { filters: filtros });
    if (!r || este !== pedido) return;
    lista.replaceChildren();
    pendentes = r.results;
    const n = r.results.length;
    const onde = [termo && `para «${termo}»`, escolhidas.length && `em ${escolhidas.map((o) => o.dataset.valor).join(', ')}`].filter(Boolean).join(' ');
    estado.textContent = n === 0 ? `Não encontrei nada ${onde}.` : `${n === 1 ? '1 resultado' : `${n} resultados`} ${onde}.`;
    await mostrar(POR_PAGINA);
  }

  let espera: number;
  campo.addEventListener('input', () => {
    clearTimeout(espera);
    espera = window.setTimeout(pesquisar, 300);
  });
  for (const s of listas) s.addEventListener('change', pesquisar);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(espera);
    pesquisar();
  });
  mais.addEventListener('click', () => mostrar(POR_PAGINA));

  try {
    // O índice só existe depois de `npm run build` (o Pagefind corre sobre dist).
    const url = '/pagefind/pagefind.js';
    pagefind = await import(/* @vite-ignore */ url);
    await pagefind.options({ excerptLength: 24 });
    const contagens = await pagefind.filters();
    for (const s of listas)
      for (const o of [...s.options].filter((o) => o.value)) {
        const n = contagens[s.name]?.[o.dataset.valor!] ?? 0;
        if (n) o.textContent += ` (${n})`;
        else o.remove();
      }
    const parametros = new URLSearchParams(location.search);
    campo.value = parametros.get('q') ?? '';
    for (const s of listas) s.value = [...s.options].some((o) => o.value === parametros.get(s.name)) ? parametros.get(s.name)! : '';
    form.hidden = false;
    alternativa.hidden = true;
    if (campo.value || listas.some((s) => s.value)) pesquisar();
    else campo.focus();
  } catch {
    alternativa.querySelector('.aviso')!.textContent = 'A pesquisa não está disponível neste momento. Podes procurar nestas páginas:';
  }
</script>

<style>
  h1 { font-size: 2.5rem; margin-top: 2.5rem; margin-bottom: 1rem; }
  [hidden] { display: none !important; }

  .filtros { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .filtro { display: grid; gap: 0.35rem; flex: 1 1 12rem; min-width: 0; }
  .filtro label { color: var(--texto-suave); }
  select {
    width: 100%;
    font: inherit;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--campo);
    border-radius: 6px;
    background: var(--superficie);
    color: var(--texto);
  }

  .mais {
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1.1rem;
    border: 0;
    border-radius: 6px;
    background: var(--azul);
    color: #fff;
    cursor: pointer;
  }
  .mais:hover { background: var(--azul-escuro); }

  .estado { color: var(--texto-suave); font-size: 0.9rem; margin: 1rem 0 0; }
  .estado:empty { margin: 0; }

  .resultados { list-style: none; padding: 0; margin: 0.5rem 0 1.5rem; max-width: var(--leitura); }
  /* Os resultados são criados no browser e não têm o atributo de escopo do Astro: daí o :global. */
  .resultados :global(li) { padding: 1rem 0; border-bottom: 1px solid var(--linha); min-width: 0; }
  .resultados :global(a) { font-family: var(--f-titulo); font-size: 1.3rem; font-weight: 600; color: var(--texto); text-decoration: none; overflow-wrap: anywhere; }
  .resultados :global(a:hover) { color: var(--destaque); text-decoration: underline; }
  .resultados :global(.meta) { font-size: 0.8rem; color: var(--texto-suave); margin: 0.15rem 0 0; text-transform: capitalize; }
  .resultados :global(.excerto) { font-size: 1rem; color: var(--texto-suave); margin: 0.4rem 0 0; overflow-wrap: anywhere; }
  .resultados :global(mark) { background: var(--dourado-claro); color: var(--texto); box-shadow: inset 0 -2px var(--dourado); padding: 0 0.1em; }

  .alternativa { font-size: 0.95rem; }
  .aviso { color: var(--texto-suave); }
</style>
