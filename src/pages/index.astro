---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import IssueCard from '../components/IssueCard.astro';
import { getIssueArticles, getCurrentIssue, getSortedIssues, monthYear, issueLabel, articleSlug } from '../lib/issues';
import { SECTIONS } from '../lib/sections';

const issues = await getSortedIssues();
const currentIssue = await getCurrentIssue();
const articles = await getIssueArticles(currentIssue.id);
// The first sentence of the cover quote is the heading; without a quote, the newspaper's name.
const headline = currentIssue.data.citacao?.texto.match(/^[^.!?]+/)?.[0].trim() ?? 'Jornal de Matemática';
---

<Base>
  <h1 class="visually-hidden">+MAT, Jornal de Matemática do Agrupamento de Escolas Domingos Sequeira</h1>
  <section class="container home-top" aria-labelledby="current-issue">
    <div class="feature">
      <div class="feature-text">
        <p class="ui eyebrow">
          {issueLabel(currentIssue)} · <span class="capitalize">{monthYear(currentIssue.data.data)}</span>
        </p>
        <h2 id="current-issue">{headline}</h2>
        {currentIssue.data.citacao && <p class="quote-author">— {currentIssue.data.citacao.autor}</p>}
        <p class="editors">Direção e edição de {currentIssue.data.direcao.join(' e ')}</p>
        <a class="ui read-issue" href={`/edicoes/${currentIssue.id}/`}>
          Ler a edição
        </a>
      </div>
      {currentIssue.data.capa && (
        <a href={`/edicoes/${currentIssue.id}/`} class="cover" tabindex="-1" aria-hidden="true">
          <Image
            src={currentIssue.data.capa}
            alt="Capa da edição atual"
            width={480}
            loading="eager"
            fetchpriority="high"
          />
        </a>
      )}
    </div>
  </section>

  <section class="container" aria-labelledby="in-this-issue">
    <h2 id="in-this-issue" class="section-heading">
      Nesta edição
    </h2>
    <ol class="contents">
      {articles.map((article) => (
        <li>
          <a class="card" href={`/edicoes/${currentIssue.id}/${articleSlug(article)}/`}>
            <span class="tag">{SECTIONS[article.data.seccao]}</span>
            <strong>{article.data.titulo}</strong>
            {article.data.resumo && <span class="summary">{article.data.resumo}</span>}
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="container" aria-labelledby="past-issues">
    <h2 id="past-issues" class="section-heading">
      Edições anteriores
    </h2>
    <div class="issue-grid">
      {issues
        .filter((issue) => issue.id !== currentIssue.id)
        .map((issue) => (
          <IssueCard issue={issue} />
        ))}
    </div>
  </section>
</Base>

<style>
  .home-top {
    padding-top: 1rem;
  }
  @media (min-width: 769px) {
    .home-top {
      padding-top: 1.5rem;
    }
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 7rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--feature-bg);
    color: var(--on-feature);
    box-shadow: var(--feature-shadow);
  }
  @media (min-width: 769px) {
    .feature {
      grid-template-columns: 1fr 13.75rem;
      gap: 2rem;
      padding: 2.5rem;
    }
  }
  .feature-text {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .feature p {
    margin: 0;
  }
  .eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .feature h2 {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  @media (min-width: 769px) {
    .feature h2 {
      font-size: 2.75rem;
    }
  }
  .quote-author {
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }
  .editors {
    font-size: 1.0625rem;
    opacity: 0.92;
  }
  .read-issue {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.375rem;
    border-radius: 24px;
    background: var(--feature-button);
    color: var(--on-feature-button);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .read-issue:focus-visible {
    outline-color: var(--on-feature);
  }
  .cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    transform: rotate(3deg);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.3);
  }

  .section-heading {
    margin: 2.5rem 0 1rem;
  }
  .contents {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1rem 1.25rem;
  }
  .contents .card {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    align-content: start;
    height: 100%;
    padding: 1.25rem;
  }
  .contents strong {
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }
  @media (min-width: 769px) {
    .contents strong {
      font-size: 1.1875rem;
    }
  }
  .summary {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .issue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.5rem;
  }
</style>
