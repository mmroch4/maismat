---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CartaoEdicao from '../components/CartaoEdicao.astro';
import AnelProgresso from '../components/AnelProgresso.astro';
import { artigosDe, edicaoAtual, edicoesOrdenadas, mesAno, rotuloEdicao, slugArtigo } from '../lib/edicoes';
import { desafiosPublicados } from '../lib/desafios';
import { SECCOES } from '../lib/seccoes';

const edicoes = await edicoesOrdenadas();
const atual = await edicaoAtual();
const artigos = await artigosDe(atual.id);
const desafios = await desafiosPublicados();
const novos = new Set(desafios.filter((d) => d.edicao.id === atual.id).map((d) => d.id)).size;
// A primeira frase da citação da capa serve de título; sem citação, o nome do jornal.
const frase = atual.data.citacao?.texto.match(/^[^.!?]+/)?.[0].trim() ?? 'Jornal de Matemática';
const mes = mesAno(atual.data.data).split(' ')[0];
---

<Base>
  <h1 class="visualmente-oculto">+MAT, Jornal de Matemática do Agrupamento de Escolas Domingos Sequeira</h1>
  <section class="contentor topo-inicio" aria-labelledby="edicao-atual">
    <div class="destaque">
      <div class="destaque-texto">
        <p class="ui rotulo">{rotuloEdicao(atual)} · <span class="cap">{mesAno(atual.data.data)}</span></p>
        <h2 id="edicao-atual">{frase}</h2>
        {atual.data.citacao && <p class="autor">— {atual.data.citacao.autor}</p>}
        <p class="direcao">Direção e edição de {atual.data.direcao.join(' e ')}</p>
        <a class="ui ler" href={`/edicoes/${atual.id}/`}>Ler a edição</a>
      </div>
      {atual.data.capa && (
        <a href={`/edicoes/${atual.id}/`} class="capa-img" tabindex="-1" aria-hidden="true">
          <Image src={atual.data.capa} alt="Capa da edição atual" width={480} loading="eager" fetchpriority="high" />
        </a>
      )}
    </div>
    <div class="cartao progresso ui">
      <h2>Os teus desafios</h2>
      <AnelProgresso ids={desafios.map((d) => d.id)} />
      <a class="botao secundario" href="/desafios/">{novos === 1 ? '1 desafio novo' : `${novos} desafios novos`} em {mes}</a>
    </div>
  </section>

  <section class="contentor" aria-labelledby="nesta-edicao">
    <h2 id="nesta-edicao" class="secao-titulo">Nesta edição</h2>
    <ol class="sumario">
      {artigos.map((a) => (
        <li>
          <a class="cartao" href={`/edicoes/${atual.id}/${slugArtigo(a)}/`}>
            <span class="etiqueta">{SECCOES[a.data.seccao]}</span>
            <strong>{a.data.titulo}</strong>
            {a.data.resumo && <span class="resumo">{a.data.resumo}</span>}
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="contentor" aria-labelledby="anteriores">
    <h2 id="anteriores" class="secao-titulo">Edições anteriores</h2>
    <div class="grelha-edicoes">
      {edicoes.filter((e) => e.id !== atual.id).map((e) => <CartaoEdicao edicao={e} />)}
    </div>
  </section>
</Base>

<style>
  .topo-inicio { display: grid; gap: 1rem; padding-top: 1rem; }
  @media (min-width: 769px) { .topo-inicio { grid-template-columns: 2fr 1fr; gap: 1.5rem; padding-top: 1.5rem; } }

  .destaque {
    display: grid;
    grid-template-columns: 1fr 7rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: var(--raio);
    background: var(--primaria);
    color: var(--primaria-texto);
  }
  @media (min-width: 769px) { .destaque { grid-template-columns: 1fr 13.75rem; gap: 2rem; padding: 2.5rem; } }
  .destaque-texto { display: grid; gap: 0.75rem; justify-items: start; }
  .destaque p { margin: 0; }
  .rotulo { font-size: 0.875rem; font-weight: 600; }
  .destaque h2 { margin: 0; font-size: 1.75rem; line-height: 1.05; letter-spacing: -0.03em; }
  @media (min-width: 769px) { .destaque h2 { font-size: 2.75rem; } }
  .autor { font-family: var(--f-ui); font-size: 0.875rem; }
  .direcao { font-size: 1.0625rem; opacity: 0.92; }
  .ler {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.375rem;
    border-radius: 24px;
    background: var(--superficie);
    color: var(--texto);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .ler:focus-visible { outline-color: var(--primaria-texto); }
  .capa-img img { display: block; width: 100%; height: auto; border-radius: var(--raio-p); transform: rotate(3deg); box-shadow: 0 12px 30px rgb(0 0 0 / 0.3); }

  .progresso { display: grid; gap: 1rem; align-content: start; padding: 1.5rem; }
  .progresso h2 { margin: 0; font-size: 1.125rem; letter-spacing: 0; }

  .secao-titulo { margin: 2.5rem 0 1rem; }
  .sumario { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1rem 1.25rem; }
  .sumario .cartao { display: grid; gap: 0.5rem; justify-items: start; align-content: start; height: 100%; padding: 1.25rem; }
  .sumario strong { font-family: var(--f-ui); font-size: 1.0625rem; font-weight: 700; line-height: 1.3; }
  @media (min-width: 769px) { .sumario strong { font-size: 1.1875rem; } }
  .resumo { font-size: 0.9375rem; color: var(--texto-suave); line-height: 1.45; }
  .grelha-edicoes { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 1.5rem; }
</style>
