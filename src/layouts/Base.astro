---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { edicoesOrdenadas, mesAno, type Edicao } from '../lib/edicoes';

interface Props {
  titulo?: string;
  descricao?: string;
  // Edição cuja capa aparece ao partilhar a página; por omissão, a mais recente com capa.
  edicao?: Edicao;
  artigo?: boolean;
}

const { titulo, descricao = 'Jornal de Matemática do Agrupamento de Escolas Domingos Sequeira, Leiria.', artigo = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · +MAT` : '+MAT · Jornal de Matemática';
const caminho = Astro.url.pathname;

// Partilha (WhatsApp, Teams…): a capa inteira em JPEG, que todos leem.
const edicao = Astro.props.edicao?.data.capa ? Astro.props.edicao : (await edicoesOrdenadas()).find((e) => e.data.capa);
const partilha = edicao && (await getImage({ src: edicao.data.capa!, format: 'jpeg', width: 600, quality: 80 }));
const nav = [
  { href: '/edicoes/', texto: 'Edições' },
  { href: '/seccoes/', texto: 'Secções' },
  { href: '/desafios/', texto: 'Desafios' },
  { href: '/sobre/', texto: 'Sobre' },
  { href: '/pesquisa/', texto: 'Pesquisar' },
];
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content={artigo ? 'article' : 'website'} />
    <meta property="og:url" content={new URL(caminho, Astro.site)} />
    <meta property="og:site_name" content="+MAT" />
    <meta property="og:locale" content="pt_PT" />
    {partilha && (
      <>
        <meta property="og:image" content={new URL(partilha.src, Astro.site)} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(partilha.attributes.width)} />
        <meta property="og:image:height" content={String(partilha.attributes.height)} />
        <meta property="og:image:alt" content={`Capa da edição de ${mesAno(edicao.data.data)} do +MAT`} />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="+MAT · Edições" href="/rss.xml" />
  </head>
  <body>
    <a class="saltar ui nao-imprimir" href="#conteudo">Saltar para o conteúdo</a>
    <header class="topo nao-imprimir">
      <div class="contentor topo-linha">
        <a href="/" class="marca" aria-label="+MAT, página inicial">+MAT</a>
        <nav class="ui" aria-label="Principal">
          {nav.map((l) => (
            <a href={l.href} aria-current={caminho.startsWith(l.href) ? 'page' : undefined}>{l.texto}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape nao-imprimir">
      <div class="contentor ui">
        <p>
          <strong>+MAT — Jornal de Matemática</strong> do Agrupamento de Escolas Domingos Sequeira.
          Direção e edição de Rosa Bértolo e Carla Nunes.
        </p>
        <p>
          Versão digital desenvolvida por <a href="https://miguelrocha.dev">Miguel Rocha</a> e disponibilizada
          gratuitamente à escola. <a href="/sobre/">Créditos</a> · <a href="/rss.xml">RSS das edições</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .topo {
    background: var(--superficie);
    border-bottom: 3px solid var(--dourado);
  }
  .topo-linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.6rem;
  }
  .marca {
    font-family: var(--f-titulo);
    font-size: 2rem;
    font-weight: 600;
    color: var(--texto);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  nav { display: flex; gap: 1.25rem; flex-wrap: wrap; font-size: 0.95rem; }
  nav a { color: var(--texto-suave); text-decoration: none; padding-block: 0.25rem; }
  nav a:hover, nav a[aria-current] { color: var(--texto); box-shadow: inset 0 -2px var(--dourado); }

  main { padding-bottom: 4rem; }

  .rodape {
    border-top: 1px solid var(--linha);
    background: var(--superficie);
    font-size: 0.875rem;
    color: var(--texto-suave);
    padding-block: 1.5rem;
  }
  .rodape p { margin: 0.35rem 0; }
</style>
