---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Logotipo from '../components/Logotipo.astro';
import Icone from '../components/Icone.astro';
// As duas fontes que quase todas as páginas usam logo no início: títulos e interface, e texto.
import fonteTitulos from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import fonteTexto from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import { edicaoAtual, edicoesOrdenadas, mesAno, type Edicao } from '../lib/edicoes';
import { jsonLd } from '../lib/dados-estruturados';

interface Props {
  titulo?: string;
  descricao?: string;
  // Edição cuja capa aparece ao partilhar a página; por omissão, a mais recente com capa.
  edicao?: Edicao;
  artigo?: boolean;
  // A 404 é servida em qualquer endereço: não tem endereço próprio e não deve ser indexada.
  naoEncontrada?: boolean;
  // Dados estruturados (schema.org); o endereço e a imagem são acrescentados aqui.
  dados?: Record<string, unknown>;
}

const {
  titulo,
  descricao = 'Jornal de Matemática do Agrupamento de Escolas Domingos Sequeira, Leiria.',
  artigo = false,
  naoEncontrada = false,
  dados,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} · +MAT` : '+MAT · Jornal de Matemática';
const caminho = Astro.url.pathname;
const endereco = new URL(caminho, Astro.site);

// Partilha (WhatsApp, Teams…): a capa inteira em JPEG, que todos leem.
const edicoes = await edicoesOrdenadas();
const edicao = Astro.props.edicao?.data.capa ? Astro.props.edicao : edicoes.find((e) => e.data.capa);
const atual = await edicaoAtual();
const mesAtual = atual && mesAno(atual.data.data).replace(/^./, (c) => c.toUpperCase());
// O Astro não aumenta imagens: com uma capa mais estreita que 600 px, o og:image:width tem de ser a largura dela.
const partilha =
  edicao &&
  (await getImage({
    src: edicao.data.capa!,
    format: 'jpeg',
    width: Math.min(600, edicao.data.capa!.width),
    quality: 80,
  }));
const imagem = partilha && new URL(partilha.src, Astro.site);
const nav = [
  { href: '/', texto: 'Início', icone: 'inicio' },
  { href: '/edicoes/', texto: 'Edições', icone: 'edicoes' },
  { href: '/seccoes/', texto: 'Secções', icone: 'seccoes' },
  { href: '/desafios/', texto: 'Desafios', icone: 'desafios' },
  { href: '/sobre/', texto: 'Sobre', icone: 'sobre' },
  { href: '/pesquisa/', texto: 'Pesquisar', icone: 'pesquisar' },
] as const;
// No telemóvel, Secções e Sobre vão para a folha «Mais».
const navBaixo = nav.filter((l) => l.href !== '/seccoes/' && l.href !== '/sobre/');
const atualDe = (href: string) => ((href === '/' ? caminho === '/' : caminho.startsWith(href)) ? 'page' : undefined);
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // O tema escolhido no rodapé, aplicado antes de a página aparecer, para não piscar.
      try {
        const tema = localStorage.getItem('maismat:tema');
        if (tema === 'claro' || tema === 'escuro') document.documentElement.dataset.tema = tema;
      } catch {}
    </script>
    <link rel="preload" href={fonteTitulos} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fonteTexto} as="font" type="font/woff2" crossorigin />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {naoEncontrada ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={endereco} />}
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content={artigo ? 'article' : 'website'} />
    {!naoEncontrada && <meta property="og:url" content={endereco} />}
    <meta property="og:site_name" content="+MAT" />
    <meta property="og:locale" content="pt_PT" />
    {partilha && (
      <>
        <meta property="og:image" content={imagem} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(partilha.attributes.width)} />
        <meta property="og:image:height" content={String(partilha.attributes.height)} />
        <meta property="og:image:alt" content={`Capa da edição de ${mesAno(edicao.data.data)} do +MAT`} />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="+MAT · Edições" href="/rss.xml" />
    {dados && (
      <script
        type="application/ld+json"
        set:html={jsonLd({ '@context': 'https://schema.org', ...dados, url: endereco.href, image: imagem?.href })}
      />
    )}
  </head>
  <body>
    <a class="saltar ui nao-imprimir" href="#conteudo">
      Saltar para o conteúdo
    </a>
    <p class="faixa ui nao-imprimir">
      <span class="so-computador">
        Versão digital do +MAT desenvolvida por <a href="https://miguelrocha.dev">Miguel Rocha</a> · miguelrocha.dev
      </span>
      <span class="so-telemovel">
        Versão digital por <a href="https://miguelrocha.dev">Miguel Rocha</a>
      </span>
    </p>
    <header class="topo ui nao-imprimir">
      <div class="contentor topo-linha">
        <a href="/" class="marca" aria-label="+MAT, página inicial">
          <Logotipo />
        </a>
        <nav class="nav-topo" aria-label="Principal">
          {nav.map((l) => (
            <a href={l.href} aria-current={atualDe(l.href)}>
              <Icone nome={l.icone} />
              {l.texto}
            </a>
          ))}
        </nav>
        {atual && (
          <a class="edicao-atual" href={`/edicoes/${atual.id}/`} aria-label={`Edição atual, ${mesAtual}`}>
            <span class="etiqueta">{mesAtual}</span>
          </a>
        )}
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape ui nao-imprimir">
      <div class="contentor rodape-linha">
        <p>
          +MAT · Jornal de Matemática do Agrupamento de Escolas Domingos Sequeira · Direção e edição de Rosa Bértolo e
          Carla Nunes · Versão digital de <a href="https://miguelrocha.dev">Miguel Rocha</a>
        </p>
        <p class="rodape-ligacoes">
          <a href="/sobre/">Sobre e créditos</a>
          <a href="/rss.xml">RSS</a>
          <button type="button" class="mudar-tema" hidden>
            Tema escuro
          </button>
        </p>
      </div>
    </footer>

    <nav class="nav-baixo ui nao-imprimir" aria-label="Principal">
      {navBaixo.map((l) => (
        <a href={l.href} aria-current={atualDe(l.href)}>
          <Icone nome={l.icone} tamanho={22} />
          {l.texto}
        </a>
      ))}
      <button type="button" class="abrir-mais" aria-haspopup="dialog" aria-controls="mais">
        <Icone nome="mais" tamanho={22} />
        Mais
      </button>
    </nav>

    <dialog id="mais" class="mais ui nao-imprimir" aria-label="Mais">
      <Logotipo />
      <ul>
        <li>
          <a href="/seccoes/" aria-current={atualDe('/seccoes/')}>
            Secções
          </a>
        </li>
        <li>
          <a href="/sobre/" aria-current={atualDe('/sobre/')}>
            Sobre o +MAT
          </a>
        </li>
        <li>
          <a href="/desafios/#levar">Levar o progresso dos desafios</a>
        </li>
        <li>
          <a href="/rss.xml">RSS das edições</a>
        </li>
      </ul>
      <p>
        Direção e edição de Rosa Bértolo e Carla Nunes. Versão digital de{' '}
        <a href="https://miguelrocha.dev">Miguel Rocha</a>.
      </p>
      <form method="dialog">
        <button>Fechar</button>
      </form>
    </dialog>

    <script>
      const raiz = document.documentElement;
      const sistema = matchMedia('(prefers-color-scheme: dark)');
      const botaoTema = document.querySelector<HTMLButtonElement>('.mudar-tema')!;
      const escuro = () => (raiz.dataset.tema ? raiz.dataset.tema === 'escuro' : sistema.matches);
      // O botão diz o tema para onde se vai.
      const mostrarTema = () => (botaoTema.textContent = escuro() ? 'Tema claro' : 'Tema escuro');
      botaoTema.addEventListener('click', () => {
        raiz.dataset.tema = escuro() ? 'claro' : 'escuro';
        try {
          localStorage.setItem('maismat:tema', raiz.dataset.tema);
        } catch {}
        mostrarTema();
      });
      sistema.addEventListener('change', mostrarTema);
      mostrarTema();
      botaoTema.hidden = false;

      const mais = document.querySelector<HTMLDialogElement>('#mais')!;
      document.querySelector('.abrir-mais')!.addEventListener('click', () => mais.showModal());
      // Tocar fora da folha fecha-a; as ligações para a mesma página (#levar) também.
      mais.addEventListener('click', (e) => {
        if (e.target === mais || (e.target as Element).closest('a')) mais.close();
      });
    </script>
  </body>
</html>

<style>
  .faixa {
    margin: 0;
    padding: 0.375rem 1rem;
    background: var(--faixa);
    color: var(--texto-suave);
    font-size: 0.75rem;
    line-height: 1.4;
    text-align: center;
  }
  .faixa a {
    color: var(--texto);
    font-weight: 600;
    text-decoration: none;
  }
  .faixa a:hover {
    text-decoration: underline;
  }

  .topo-linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .marca {
    display: block;
    font-size: 1.625rem;
    color: var(--texto);
    padding-block: 0.5rem;
  }
  .edicao-atual {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .nav-topo {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--superficie);
    border-radius: 26px;
    box-shadow: var(--sombra);
  }
  .nav-topo a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: var(--raio-g);
    color: var(--texto);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .nav-topo a:hover {
    background: var(--pastilha);
  }
  .nav-topo a[aria-current] {
    background: var(--primaria);
    color: var(--primaria-texto);
    font-weight: 600;
  }
  .nav-topo a:focus-visible {
    outline-color: var(--texto);
  }

  main {
    padding-bottom: 4rem;
  }

  .rodape-linha {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--linha);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }
  .rodape p {
    margin: 0;
  }
  .rodape a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .rodape-ligacoes {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }
  .rodape-ligacoes a,
  .mudar-tema {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .mudar-tema[hidden] {
    display: none;
  }
  .mudar-tema {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .nav-baixo {
    display: none;
  }

  .mais {
    width: 100%;
    max-width: 30rem;
    margin: auto auto 0;
    padding: 1.25rem 1rem calc(1.5rem + env(safe-area-inset-bottom));
    border: 0;
    border-radius: 24px 24px 0 0;
    background: var(--superficie);
    color: var(--texto);
  }
  .mais::backdrop {
    background: rgb(27 36 48 / 0.45);
  }
  .mais > :global(.logotipo) {
    font-size: 1.625rem;
    margin: 0 0.25rem 0.75rem;
  }
  .mais ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .mais li a {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 0.75rem;
    border-radius: var(--raio);
    color: var(--texto);
    font-weight: 600;
    text-decoration: none;
  }
  .mais li a:hover,
  .mais li a[aria-current] {
    background: var(--fundo);
  }
  .mais p {
    margin: 0.75rem 0.25rem 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }
  .mais form button {
    width: 100%;
    min-height: 48px;
    margin-top: 0.75rem;
    border: 0;
    border-radius: var(--raio);
    background: var(--pastilha);
    color: var(--texto);
    font: 700 0.9375rem var(--f-ui);
    cursor: pointer;
  }

  @media (min-width: 769px) {
    .so-telemovel,
    .edicao-atual {
      display: none;
    }
    .topo-linha {
      padding-block: 1rem;
    }
    .marca {
      font-size: 1.875rem;
    }
    .rodape-linha {
      padding-block: 1.25rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .so-computador,
    .nav-topo {
      display: none;
    }
    .topo {
      background: var(--superficie);
      border-bottom: 1px solid var(--linha);
    }
    main {
      padding-bottom: 2.5rem;
    }
    .rodape {
      padding-bottom: calc(57px + env(safe-area-inset-bottom));
    }
    .rodape-linha {
      display: block;
      padding-block: 1rem 0.5rem;
    }
    .rodape .rodape-ligacoes {
      margin-top: 0.25rem;
    }

    .nav-baixo {
      position: fixed;
      inset: auto 0 0;
      z-index: 5;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--superficie);
      border-top: 1px solid var(--linha);
    }
    .nav-baixo a,
    .nav-baixo button {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      min-height: 56px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--texto-suave);
      font: 500 0.6875rem var(--f-ui);
      text-decoration: none;
      cursor: pointer;
    }
    .nav-baixo [aria-current] {
      color: var(--primaria);
      font-weight: 700;
    }
    .nav-baixo :focus-visible {
      outline-offset: -3px;
    }
  }
</style>
