---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
// The two fonts almost every page uses right away: headings and interface, and body text.
import headingFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import { getCurrentIssue, getSortedIssues, monthYear, type Issue } from '../lib/issues';
import { jsonLd } from '../lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  // Issue whose cover is shown when the page is shared; by default, the newest one with a cover.
  issue?: Issue;
  isArticle?: boolean;
  // The 404 page is served at any address: it has no address of its own and must not be indexed.
  isNotFound?: boolean;
  // Structured data (schema.org); the URL and the image are added here.
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'Jornal de Matemática do Agrupamento de Escolas Domingos Sequeira, Leiria.',
  isArticle = false,
  isNotFound = false,
  structuredData,
} = Astro.props;
const fullTitle = title ? `${title} · +MAT` : '+MAT · Jornal de Matemática';
const path = Astro.url.pathname;
const pageUrl = new URL(path, Astro.site);

// Sharing (WhatsApp, Teams…): the whole cover as a JPEG, which every app reads.
const issues = await getSortedIssues();
const shareIssue = Astro.props.issue?.data.cover ? Astro.props.issue : issues.find((issue) => issue.data.cover);
const currentIssue = await getCurrentIssue();
const currentMonth = currentIssue && monthYear(currentIssue.data.date).replace(/^./, (c) => c.toUpperCase());
// Astro never upscales images: with a cover narrower than 600 px, og:image:width must be its width.
const shareImage =
  shareIssue &&
  (await getImage({
    src: shareIssue.data.cover!,
    format: 'jpeg',
    width: Math.min(600, shareIssue.data.cover!.width),
    quality: 80,
  }));
const shareImageUrl = shareImage && new URL(shareImage.src, Astro.site);
const navLinks = [
  { href: '/', label: 'Início', icon: 'home' },
  { href: '/edicoes/', label: 'Edições', icon: 'issues' },
  { href: '/seccoes/', label: 'Secções', icon: 'sections' },
  { href: '/desafios/', label: 'Desafios', icon: 'challenges' },
  { href: '/sobre/', label: 'Sobre', icon: 'about' },
  { href: '/pesquisa/', label: 'Pesquisar', icon: 'search' },
] as const;
// On phones, Sections and About move to the "More" sheet.
const bottomNavLinks = navLinks.filter((link) => link.href !== '/seccoes/' && link.href !== '/sobre/');
const ariaCurrent = (href: string) => ((href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined);
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // The theme picked in the footer, applied before the page shows up so it does not flash.
      // Keep the key in sync with THEME_KEY in src/lib/storage.ts.
      try {
        const theme = localStorage.getItem('maismat:theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    {!isNotFound && <meta property="og:url" content={pageUrl} />}
    <meta property="og:site_name" content="+MAT" />
    <meta property="og:locale" content="pt_PT" />
    {shareImage && (
      <>
        <meta property="og:image" content={shareImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(shareImage.attributes.width)} />
        <meta property="og:image:height" content={String(shareImage.attributes.height)} />
        <meta property="og:image:alt" content={`Capa da edição de ${monthYear(shareIssue.data.date)} do +MAT`} />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="+MAT · Edições" href="/rss.xml" />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={jsonLd({
          '@context': 'https://schema.org',
          ...structuredData,
          url: pageUrl.href,
          image: shareImageUrl?.href,
        })}
      />
    )}
  </head>
  <body>
    <a class="skip-link ui no-print" href="#content">
      Saltar para o conteúdo
    </a>
    <p class="band ui no-print">
      <span class="desktop-only">
        Versão digital do +MAT desenvolvida por <a href="https://miguelrocha.dev">Miguel Rocha</a> · miguelrocha.dev
      </span>
      <span class="mobile-only">
        Versão digital por <a href="https://miguelrocha.dev">Miguel Rocha</a>
      </span>
    </p>
    <header class="site-header ui no-print">
      <div class="container site-header-row">
        <a href="/" class="brand" aria-label="+MAT, página inicial">
          <Logo />
        </a>
        <nav class="top-nav" aria-label="Principal">
          {navLinks.map((link) => (
            <a href={link.href} aria-current={ariaCurrent(link.href)}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          ))}
        </nav>
        {currentIssue && (
          <a class="current-issue" href={`/edicoes/${currentIssue.id}/`} aria-label={`Edição atual, ${currentMonth}`}>
            <span class="tag">{currentMonth}</span>
          </a>
        )}
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer ui no-print">
      <div class="container site-footer-row">
        <p>
          +MAT · Jornal de Matemática do Agrupamento de Escolas Domingos Sequeira · Direção e edição de Rosa Bértolo e
          Carla Nunes · Versão digital de <a href="https://miguelrocha.dev">Miguel Rocha</a>
        </p>
        <p class="site-footer-links">
          <a href="/sobre/">Sobre e créditos</a>
          <a href="/rss.xml">RSS</a>
          <button type="button" class="theme-toggle" hidden>
            Tema escuro
          </button>
        </p>
      </div>
    </footer>

    <nav class="bottom-nav ui no-print" aria-label="Principal">
      {bottomNavLinks.map((link) => (
        <a href={link.href} aria-current={ariaCurrent(link.href)}>
          <Icon name={link.icon} size={22} />
          {link.label}
        </a>
      ))}
      <button type="button" class="open-more" aria-haspopup="dialog" aria-controls="more">
        <Icon name="more" size={22} />
        Mais
      </button>
    </nav>

    <dialog id="more" class="more ui no-print" aria-label="Mais">
      <Logo />
      <ul>
        <li>
          <a href="/seccoes/" aria-current={ariaCurrent('/seccoes/')}>
            Secções
          </a>
        </li>
        <li>
          <a href="/sobre/" aria-current={ariaCurrent('/sobre/')}>
            Sobre o +MAT
          </a>
        </li>
        <li>
          <a href="/desafios/#levar">Levar o progresso dos desafios</a>
        </li>
        <li>
          <a href="/rss.xml">RSS das edições</a>
        </li>
      </ul>
      <p>
        Direção e edição de Rosa Bértolo e Carla Nunes. Versão digital de{' '}
        <a href="https://miguelrocha.dev">Miguel Rocha</a>.
      </p>
      <form method="dialog">
        <button>Fechar</button>
      </form>
    </dialog>

    <script>
      import { THEME_KEY, type Theme } from '../lib/storage';

      const root = document.documentElement;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : systemDark.matches);
      // The button names the theme it switches to.
      const updateToggle = () => (themeToggle.textContent = isDark() ? 'Tema claro' : 'Tema escuro');
      themeToggle.addEventListener('click', () => {
        const theme: Theme = isDark() ? 'light' : 'dark';
        root.dataset.theme = theme;
        try {
          localStorage.setItem(THEME_KEY, theme);
        } catch {}
        updateToggle();
      });
      systemDark.addEventListener('change', updateToggle);
      updateToggle();
      themeToggle.hidden = false;

      const moreSheet = document.querySelector<HTMLDialogElement>('#more')!;
      document.querySelector('.open-more')!.addEventListener('click', () => moreSheet.showModal());
      // Tapping outside the sheet closes it, and so do links to the same page (#levar).
      moreSheet.addEventListener('click', (event) => {
        if (event.target === moreSheet || (event.target as Element).closest('a')) moreSheet.close();
      });
    </script>
  </body>
</html>

<style>
  .band {
    margin: 0;
    padding: 0.375rem 1rem;
    background: var(--band);
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    text-align: center;
  }
  .band a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .band a:hover {
    text-decoration: underline;
  }

  .site-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .brand {
    display: block;
    font-size: 1.625rem;
    color: var(--text);
    padding-block: 0.5rem;
  }
  .current-issue {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .top-nav {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--surface);
    border-radius: 26px;
    box-shadow: var(--shadow);
  }
  .top-nav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: var(--radius-lg);
    color: var(--text);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .top-nav a:hover {
    background: var(--pill);
  }
  .top-nav a[aria-current] {
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 600;
  }
  .top-nav a:focus-visible {
    outline-color: var(--text);
  }

  main {
    padding-bottom: 4rem;
  }

  .site-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .site-footer-links {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }
  .site-footer-links a,
  .theme-toggle {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .bottom-nav {
    display: none;
  }

  .more {
    width: 100%;
    max-width: 30rem;
    margin: auto auto 0;
    padding: 1.25rem 1rem calc(1.5rem + env(safe-area-inset-bottom));
    border: 0;
    border-radius: 24px 24px 0 0;
    background: var(--surface);
    color: var(--text);
  }
  .more::backdrop {
    background: rgb(27 36 48 / 0.45);
  }
  .more > :global(.logo) {
    font-size: 1.625rem;
    margin: 0 0.25rem 0.75rem;
  }
  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .more li a {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 0.75rem;
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .more li a:hover,
  .more li a[aria-current] {
    background: var(--bg);
  }
  .more p {
    margin: 0.75rem 0.25rem 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .more form button {
    width: 100%;
    min-height: 48px;
    margin-top: 0.75rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--pill);
    color: var(--text);
    font: 700 0.9375rem var(--font-ui);
    cursor: pointer;
  }

  @media (min-width: 769px) {
    .mobile-only,
    .current-issue {
      display: none;
    }
    .site-header-row {
      padding-block: 1rem;
    }
    .brand {
      font-size: 1.875rem;
    }
    .site-footer-row {
      padding-block: 1.25rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .desktop-only,
    .top-nav {
      display: none;
    }
    .site-header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }
    main {
      padding-bottom: 2.5rem;
    }
    .site-footer {
      padding-bottom: calc(57px + env(safe-area-inset-bottom));
    }
    .site-footer-row {
      display: block;
      padding-block: 1rem 0.5rem;
    }
    .site-footer .site-footer-links {
      margin-top: 0.25rem;
    }

    .bottom-nav {
      position: fixed;
      inset: auto 0 0;
      z-index: 5;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--surface);
      border-top: 1px solid var(--border);
    }
    .bottom-nav a,
    .bottom-nav button {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      min-height: 56px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--text-muted);
      font: 500 0.6875rem var(--font-ui);
      text-decoration: none;
      cursor: pointer;
    }
    .bottom-nav [aria-current] {
      color: var(--primary);
      font-weight: 700;
    }
    .bottom-nav :focus-visible {
      outline-offset: -3px;
    }
  }
</style>
